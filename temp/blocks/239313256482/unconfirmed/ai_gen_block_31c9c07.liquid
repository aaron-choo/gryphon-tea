{% doc %}
  @prompt
    Create a collection banner section that displays a unique hero banner image per collection. The section should allow merchants to set a different banner image, heading text, and subheading for each collection handle (e.g. mooncake-collection, best-sellers, new-in). It should check the current collection handle and display the matching banner image. The design should be full-width, premium, and consistent with a refined tea brand aesthetic.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    display: block;
    overflow: hidden;
  }

  .ai-collection-banner__wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.banner_height_mobile }}px;
  }

  .ai-collection-banner__image-container-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-collection-banner__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ block.settings.image_position }};
  }

  .ai-collection-banner__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #f4f4f7 0%, #9eb091 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-collection-banner__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
    opacity: 0.3;
  }

  .ai-collection-banner__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 24px;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 4px;
    font-size: 14px;
    color: #5e6b47;
    text-align: center;
    max-width: 90%;
  }

  .ai-collection-banner__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, {{ block.settings.overlay_opacity }});
    z-index: 1;
  }

  .ai-collection-banner__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.text_alignment }};
    justify-content: {{ block.settings.text_vertical_alignment }};
    height: 100%;
    padding: 40px 20px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-collection-banner__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size_mobile }}px;
    font-weight: 400;
    letter-spacing: 0.05em;
    margin: 0 0 16px;
    max-width: 800px;
  }

  .ai-collection-banner__subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size_mobile }}px;
    font-weight: 300;
    letter-spacing: 0.03em;
    margin: 0;
    max-width: 600px;
  }

  @media screen and (min-width: 750px) {
    .ai-collection-banner__wrapper-{{ ai_gen_id }} {
      min-height: {{ block.settings.banner_height_desktop }}px;
    }

    .ai-collection-banner__content-{{ ai_gen_id }} {
      padding: 60px 40px;
    }

    .ai-collection-banner__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }

    .ai-collection-banner__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_desktop }}px;
    }
  }
{% endstyle %}

<collection-banner-{{ ai_gen_id }} class="ai-collection-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% liquid
    assign current_handle = collection.handle
    assign banner_image = null
    assign banner_heading = ''
    assign banner_subheading = ''
    assign has_match = false

    if current_handle == block.settings.collection_handle_1 and block.settings.collection_handle_1 != blank
      assign banner_image = block.settings.banner_image_1
      assign banner_heading = block.settings.banner_heading_1
      assign banner_subheading = block.settings.banner_subheading_1
      assign has_match = true
    elsif current_handle == block.settings.collection_handle_2 and block.settings.collection_handle_2 != blank
      assign banner_image = block.settings.banner_image_2
      assign banner_heading = block.settings.banner_heading_2
      assign banner_subheading = block.settings.banner_subheading_2
      assign has_match = true
    elsif current_handle == block.settings.collection_handle_3 and block.settings.collection_handle_3 != blank
      assign banner_image = block.settings.banner_image_3
      assign banner_heading = block.settings.banner_heading_3
      assign banner_subheading = block.settings.banner_subheading_3
      assign has_match = true
    elsif current_handle == block.settings.collection_handle_4 and block.settings.collection_handle_4 != blank
      assign banner_image = block.settings.banner_image_4
      assign banner_heading = block.settings.banner_heading_4
      assign banner_subheading = block.settings.banner_subheading_4
      assign has_match = true
    elsif current_handle == block.settings.collection_handle_5 and block.settings.collection_handle_5 != blank
      assign banner_image = block.settings.banner_image_5
      assign banner_heading = block.settings.banner_heading_5
      assign banner_subheading = block.settings.banner_subheading_5
      assign has_match = true
    endif

    if has_match == false and block.settings.show_fallback
      assign banner_image = block.settings.fallback_image
      assign banner_heading = block.settings.fallback_heading
      assign banner_subheading = block.settings.fallback_subheading
    endif
  %}

  {% if has_match or block.settings.show_fallback %}
    <div class="ai-collection-banner__wrapper-{{ ai_gen_id }}">
      <div class="ai-collection-banner__image-container-{{ ai_gen_id }}">
        {% if banner_image %}
          <img
            src="{{ banner_image | image_url: width: 2400 }}"
            alt="{{ banner_image.alt | escape }}"
            loading="eager"
            width="{{ banner_image.width }}"
            height="{{ banner_image.height }}"
            class="ai-collection-banner__image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-collection-banner__placeholder-{{ ai_gen_id }}">
            {{ 'collection-apparel-1' | placeholder_svg_tag }}
            <div class="ai-collection-banner__empty-state-{{ ai_gen_id }}">
              Add a banner image for this collection
            </div>
          </div>
        {% endif %}
      </div>

      {% if block.settings.show_overlay %}
        <div class="ai-collection-banner__overlay-{{ ai_gen_id }}"></div>
      {% endif %}

      <div class="ai-collection-banner__content-{{ ai_gen_id }}">
        {% if banner_heading != blank %}
          <h1 class="ai-collection-banner__heading-{{ ai_gen_id }}">{{ banner_heading }}</h1>
        {% endif %}

        {% if banner_subheading != blank %}
          <p class="ai-collection-banner__subheading-{{ ai_gen_id }}">{{ banner_subheading }}</p>
        {% endif %}
      </div>
    </div>
  {% endif %}
</collection-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('collection-banner-{{ ai_gen_id }}', CollectionBanner{{ ai_gen_id }});
  })();
</script>

