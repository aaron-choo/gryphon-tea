<!-- ======================================================
  GRYPHON AFTER DARK — SPIRIT HUNT
======================================================= -->

<div
  id="gryphon-ghost"
  role="button"
  tabindex="0"
  aria-label="Catch Griffin"
>
  <img
    src="https://cdn.shopify.com/s/files/1/0772/8142/7490/files/Griffin_Ghost.png"
    alt="Catch Griffin"
    class="gryphon-ghost-image"
  >
</div>


<!-- POPUP -->
<div
  id="gryphon-spirit-modal"
  class="gryphon-spirit-modal"
  aria-hidden="true"
>

  <div class="gryphon-spirit-backdrop"></div>

  <div
    id="gryphon-spirit-card"
    class="gryphon-spirit-card gryphon-theme-neutral"
  >

    <button
      type="button"
      id="gryphon-close"
      class="gryphon-close"
      aria-label="Close"
    >
      ×
    </button>


    <!-- =========================
         STEP 1 — REVEAL FATE
    ========================== -->

    <div
      id="gryphon-step-reveal"
      class="gryphon-step is-active gryphon-reveal-screen"
    >

      <p class="gryphon-eyebrow">
        GRYPHON AFTER DARK
      </p>

      <h2>
        YOU CAUGHT GRIFFIN.
      </h2>

      <p>
        Trick or Treat?<br>
        Only one way to find out.
      </p>

      <button
        type="button"
        id="gryphon-reveal"
        class="gryphon-main-button"
      >
        REVEAL MY FATE
      </button>

    </div>


    <!-- =========================
         STEP 2 — PRIZE
    ========================== -->

    <div
      id="gryphon-step-prize"
      class="gryphon-step gryphon-result-screen"
    >

      <div class="gryphon-coded-area">

        <p
          id="gryphon-type"
          class="gryphon-result-type"
        >
          TRICK
        </p>

        <h2
          id="gryphon-prize-title"
          class="gryphon-prize-title"
        >
          $3 OFF
        </h2>

        <p
          id="gryphon-prize-copy"
          class="gryphon-prize-copy"
        >
          Griffin left you something after all.
        </p>


        <form id="gryphon-claim-form">

          <input
            id="gryphon-email"
            class="gryphon-email"
            type="email"
            placeholder="Email address"
            autocomplete="email"
            required
          >

          <label class="gryphon-consent">

            <input
              id="gryphon-consent"
              type="checkbox"
            >

            <span>
              Send me Gryphon news and offers.
            </span>

          </label>

          <button
            type="submit"
            class="gryphon-main-button"
          >
            CLAIM MY PRIZE
          </button>

        </form>

      </div>

    </div>


    <!-- =========================
         STEP 3 — TEST CODE
    ========================== -->

    <div
      id="gryphon-step-code"
      class="gryphon-step gryphon-result-screen"
    >

      <div class="gryphon-coded-area gryphon-coded-area--claimed">

        <p class="gryphon-result-type">
          YOURS TO KEEP
        </p>

        <h2
          id="gryphon-final-prize"
          class="gryphon-prize-title"
        >
          $3 OFF
        </h2>

        <div class="gryphon-code">

          <span id="gryphon-code-text">
            TEST-ABC123
          </span>

          <button
            type="button"
            id="gryphon-copy"
          >
            COPY
          </button>

        </div>

        <button
          type="button"
          id="gryphon-finish"
          class="gryphon-main-button"
        >
          CONTINUE SHOPPING
        </button>

      </div>

    </div>

  </div>
</div>


<style>

/* ======================================================
   FLYING GRIFFIN
======================================================= */

#gryphon-ghost {
  position: fixed;
  left: 0;
  top: 0;

  width: 120px;

  z-index: 9999998;

  opacity: 0;
  visibility: hidden;

  pointer-events: none;
  cursor: pointer;

  will-change: transform, opacity;

  -webkit-tap-highlight-color: transparent;
}

.gryphon-ghost-image {
  display: block;
  width: 85%;
  height: auto;

  pointer-events: none;
  user-select: none;
}


/* ======================================================
   MODAL
======================================================= */

.gryphon-spirit-modal {
  position: fixed;
  inset: 0;

  z-index: 9999999;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 20px;

  opacity: 0;
  visibility: hidden;
  pointer-events: none;

  transition:
    opacity 220ms ease,
    visibility 220ms ease;
}

.gryphon-spirit-modal.is-open {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.gryphon-spirit-backdrop {
  position: absolute;
  inset: 0;

  background: rgba(17, 20, 15, 0.76);

  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
}


/* ======================================================
   POPUP CARD

   DESKTOP DISPLAY = 700 × 440
======================================================= */

.gryphon-spirit-card {
  position: relative;

  width: 700px;
  height: 440px;

  max-width: calc(100vw - 40px);
  max-height: calc(100vh - 40px);

  overflow: hidden;

  box-shadow:
    0 30px 90px rgba(0, 0, 0, 0.3);

  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}


/* ---------- NEUTRAL ---------- */

.gryphon-theme-neutral {
  background: #303828;
  color: #f4efe5;
}


/* ---------- TRICK ---------- */

.gryphon-theme-trick {
  background-image:
    url("https://cdn.shopify.com/s/files/1/0772/8142/7490/files/halloween-trick-desktop.png");

  color: #f4efe5;
}


/* ---------- TREAT ---------- */

.gryphon-theme-treat {
  background-image:
    url("https://cdn.shopify.com/s/files/1/0772/8142/7490/files/halloween-treat-desktop.png");

  color: #875126;
}


/* ======================================================
   CLOSE
======================================================= */

.gryphon-close {
  position: absolute;

  right: 15px;
  top: 13px;

  z-index: 20;

  width: 34px;
  height: 34px;

  padding: 0;

  border: 0;
  background: transparent;

  color: currentColor;

  font-size: 27px;
  line-height: 1;

  cursor: pointer;
}


/* ======================================================
   STEPS
======================================================= */

.gryphon-step {
  display: none;

  width: 100%;
  height: 100%;
}

.gryphon-step.is-active {
  display: block;

  animation:
    gryphonFadeIn 280ms ease;
}


/* ======================================================
   FIRST SCREEN
======================================================= */

.gryphon-reveal-screen {
  padding: 75px 80px;

  text-align: center;
}

.gryphon-eyebrow {
  margin: 0 0 16px;

  font-size: 11px;

  letter-spacing: 0.18em;

  opacity: 0.75;
}

.gryphon-reveal-screen h2 {
  margin: 0 0 16px;

  color: inherit;

  font-family: var(--font-heading-family);

  font-size: 38px;
  line-height: 1;
}

.gryphon-reveal-screen > p:not(.gryphon-eyebrow) {
  margin: 0 auto 28px;

  font-size: 14px;
  line-height: 1.5;
}


/* ======================================================
   CODED CONTENT AREA

   Desktop = right side of artwork
   Approx. 300 × 440 px
======================================================= */

.gryphon-coded-area {
  position: absolute;

  right: 0;
  top: 0;

  width: 43%;
  height: 100%;

  padding:
    54px
    34px
    30px;

  display: flex;
  flex-direction: column;
  justify-content: center;
}


/* ======================================================
   PRIZE COPY
======================================================= */

.gryphon-result-type {
  margin: 0 0 7px;

  font-size: 10px;

  letter-spacing: 0.18em;

  text-transform: uppercase;

  opacity: 0.76;
}

.gryphon-prize-title {
  margin: 0 0 8px;

  color: inherit;

  font-family: var(--font-heading-family);

  font-size: 29px;
  line-height: 1.05;
}

.gryphon-prize-copy {
  margin: 0 0 18px;

  font-size: 12px;
  line-height: 1.4;
}


/* ======================================================
   EMAIL
======================================================= */

.gryphon-email {
  display: block;

  width: 100%;
  height: 40px;

  padding: 0 11px;

  border-radius: 0;

  font-family: var(--font-body-family);
  font-size: 12px;

  outline: none;

  background: rgba(255, 255, 255, 0.05);
}


/* Trick */

.gryphon-theme-trick .gryphon-email {
  border: 1px solid rgba(244,239,229,.55);
  color: #f4efe5;
}

.gryphon-theme-trick .gryphon-email::placeholder {
  color: rgba(244,239,229,.65);
}


/* Treat */

.gryphon-theme-treat .gryphon-email {
  border: 1px solid rgba(92,58,26,.35);

  color: #693e1e;

  background: rgba(255,255,255,.32);
}

.gryphon-theme-treat .gryphon-email::placeholder {
  color: rgba(92,58,26,.6);
}


/* ======================================================
   CONSENT
======================================================= */

.gryphon-consent {
  display: flex;
  align-items: flex-start;

  gap: 8px;

  margin:
    11px
    0
    15px;

  cursor: pointer;
}

.gryphon-consent input {
  width: 13px;
  height: 13px;

  margin-top: 1px;

  flex: 0 0 auto;
}

.gryphon-consent span {
  font-size: 10px;
  line-height: 1.35;
}


/* ======================================================
   CTA
======================================================= */

.gryphon-main-button {
  width: 100%;

  min-height: 40px;

  padding:
    11px
    15px;

  font-family: var(--font-body-family);

  font-size: 10px;

  letter-spacing: 0.13em;

  cursor: pointer;

  transition:
    background 180ms ease,
    color 180ms ease;
}


/* Neutral + Trick */

.gryphon-theme-neutral .gryphon-main-button,
.gryphon-theme-trick .gryphon-main-button {
  border: 1px solid #f4efe5;

  background: #f4efe5;

  color: #293225;
}

.gryphon-theme-neutral .gryphon-main-button:hover,
.gryphon-theme-trick .gryphon-main-button:hover {
  background: transparent;

  color: #f4efe5;
}


/* Treat */

.gryphon-theme-treat .gryphon-main-button {
  border: 1px solid #293225;

  background: #293225;

  color: #f4efe5;
}

.gryphon-theme-treat .gryphon-main-button:hover {
  background: transparent;

  color: #293225;
}


/* ======================================================
   CODE
======================================================= */

.gryphon-code {
  display: flex;

  width: 100%;

  margin:
    12px
    0
    16px;

  border: 1px solid currentColor;
}

.gryphon-code span {
  flex: 1;

  display: flex;
  align-items: center;

  min-width: 0;

  padding:
    11px
    10px;

  font-size: 10px;

  overflow-wrap: anywhere;
}

.gryphon-code button {
  width: 58px;

  padding: 0;

  border: 0;
  border-left: 1px solid currentColor;

  background: transparent;

  color: inherit;

  font-size: 9px;

  cursor: pointer;
}


/* ======================================================
   MOBILE

   DISPLAY = ~340 × 430
   Artwork top / coded content bottom
======================================================= */

@media screen and (max-width: 749px) {

  #gryphon-ghost {
    width: 95px;
  }


  .gryphon-spirit-modal {
    padding: 12px;
  }


  .gryphon-spirit-card {
    width: 340px;
    height: 430px;

    max-width: calc(100vw - 24px);
    max-height: calc(100vh - 24px);
  }


  .gryphon-theme-trick {
    background-image:
      url("https://cdn.shopify.com/s/files/1/0772/8142/7490/files/halloween-trick-mobile.png");
  }


  .gryphon-theme-treat {
    background-image:
      url("https://cdn.shopify.com/s/files/1/0772/8142/7490/files/halloween-treat-mobile.png");
  }


  .gryphon-reveal-screen {
    padding:
      64px
      28px
      30px;
  }


  .gryphon-reveal-screen h2 {
    font-size: 30px;
  }


  /*
    Mobile coded area = bottom section
  */

  .gryphon-coded-area {
    left: 0;
    right: auto;

    top: auto;
    bottom: 0;

    width: 100%;
    height: 50%;

    padding:
      19px
      25px
      18px;

    justify-content: center;
  }


  .gryphon-result-type {
    margin-bottom: 4px;

    font-size: 8px;
  }


  .gryphon-prize-title {
    margin-bottom: 5px;

    font-size: 19px;
  }


  .gryphon-prize-copy {
    margin-bottom: 10px;

    font-size: 10px;
    line-height: 1.3;
  }


  .gryphon-email {
    height: 34px;

    font-size: 11px;
  }


  .gryphon-consent {
    margin:
      8px
      0
      10px;
  }


  .gryphon-consent span {
    font-size: 8.5px;
  }


  .gryphon-main-button {
    min-height: 34px;

    padding:
      8px
      12px;

    font-size: 9px;
  }


  .gryphon-code {
    margin:
      8px
      0
      10px;
  }

}


/* ======================================================
   ANIMATION
======================================================= */

@keyframes gryphonFadeIn {

  from {
    opacity: 0;
    transform: translateY(6px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }

}

</style>


<script>

document.addEventListener('DOMContentLoaded', function () {

  const ghost =
    document.getElementById('gryphon-ghost');

  const modal =
    document.getElementById('gryphon-spirit-modal');

  const card =
    document.getElementById('gryphon-spirit-card');

  const revealButton =
    document.getElementById('gryphon-reveal');

  const claimForm =
    document.getElementById('gryphon-claim-form');

  const email =
    document.getElementById('gryphon-email');

  const typeText =
    document.getElementById('gryphon-type');

  const prizeTitle =
    document.getElementById('gryphon-prize-title');

  const prizeCopy =
    document.getElementById('gryphon-prize-copy');

  const finalPrize =
    document.getElementById('gryphon-final-prize');

  const codeText =
    document.getElementById('gryphon-code-text');

  const copyButton =
    document.getElementById('gryphon-copy');

  const closeButton =
    document.getElementById('gryphon-close');

  const finishButton =
    document.getElementById('gryphon-finish');


  if (!ghost || !modal) return;


  /* ======================================================
     TEST PRIZES FOR NOW
  ====================================================== */

  const prizes = [

    {
      type: 'TRICK',
      title: '$3 OFF',
      copy: 'Griffin left you something after all.',
      prefix: 'TRICK3',
      weight: 30
    },

    {
      type: 'TRICK',
      title: 'BOO! 10% OFF',
      copy: 'Griffin was feeling particularly cheeky.',
      prefix: 'BOO10',
      weight: 25
    },

    {
      type: 'TRICK',
      title: 'FREE SHIPPING',
      copy: 'No candy. But Griffin spared your delivery fee.',
      prefix: 'BOOSHIP',
      weight: 15
    },

    {
      type: 'TREAT',
      title: '$10 OFF',
      copy: 'Rosie has something for you.',
      prefix: 'TREAT10',
      weight: 15
    },

    {
      type: 'TREAT',
      title: '15% OFF',
      copy: 'A little goodness found its way to you.',
      prefix: 'TREAT15',
      weight: 10
    },

    {
      type: 'TREAT',
      title: '20% OFF',
      copy: 'Rosie was feeling generous.',
      prefix: 'TREAT20',
      weight: 5
    }

  ];


  let caught = false;
  let currentAnimation = null;
  let selectedPrize = null;


  function random(min, max) {
    return Math.random() * (max - min) + min;
  }


  function sleep(ms) {

    return new Promise(function (resolve) {

      setTimeout(resolve, ms);

    });

  }


  function showStep(id) {

    document
      .querySelectorAll('.gryphon-step')
      .forEach(function (step) {

        step.classList.remove('is-active');

      });


    const target =
      document.getElementById(id);


    if (target) {

      target.classList.add('is-active');

    }

  }


  function setTheme(type) {

    card.classList.remove(
      'gryphon-theme-neutral',
      'gryphon-theme-trick',
      'gryphon-theme-treat'
    );


    if (type === 'TRICK') {

      card.classList.add(
        'gryphon-theme-trick'
      );

    } else if (type === 'TREAT') {

      card.classList.add(
        'gryphon-theme-treat'
      );

    } else {

      card.classList.add(
        'gryphon-theme-neutral'
      );

    }

  }


  function pickPrize() {

    const total =
      prizes.reduce(function (sum, prize) {

        return sum + prize.weight;

      }, 0);


    let roll =
      Math.random() * total;


    for (const prize of prizes) {

      roll -= prize.weight;


      if (roll <= 0) {

        return prize;

      }

    }


    return prizes[0];

  }


  /* ======================================================
     GHOST MOVEMENT
  ====================================================== */

  function getSpawn() {

    const width =
      ghost.offsetWidth || 120;


    const height =
      ghost.offsetHeight || 120;


    return {

      x: random(
        15,
        Math.max(
          20,
          window.innerWidth - width - 20
        )
      ),

      y: random(
        90,
        Math.max(
          100,
          window.innerHeight - height - 40
        )
      )

    };

  }


  function buildPath(start) {

    const frames = [];

    let x = start.x;
    let y = start.y;


    frames.push({

      transform:
        `translate3d(${x}px, ${y}px, 0) rotate(-5deg)`

    });


    const steps =
      Math.floor(
        random(4, 7)
      );


    for (
      let i = 1;
      i <= steps;
      i++
    ) {

      x +=
        random(-150, 150);


      y +=
        i % 2 === 0
          ? random(45, 105)
          : random(-105, -45);


      x =
        Math.max(
          15,
          Math.min(
            window.innerWidth - 120,
            x
          )
        );


      y =
        Math.max(
          80,
          Math.min(
            window.innerHeight - 140,
            y
          )
        );


      frames.push({

        offset:
          i / steps,

        transform:
          `translate3d(${x}px, ${y}px, 0) rotate(${random(-11, 11)}deg)`

      });

    }


    return frames;

  }


  async function burst() {

    const spawn =
      getSpawn();


    ghost.style.visibility =
      'visible';

    ghost.style.pointerEvents =
      'auto';

    ghost.style.opacity =
      '0';

    ghost.style.transform =
      `translate3d(${spawn.x}px, ${spawn.y}px, 0)`;


    ghost.offsetHeight;


    ghost.style.transition =
      'opacity 180ms ease';

    ghost.style.opacity =
      '1';


    currentAnimation =
      ghost.animate(

        buildPath(spawn),

        {

          duration:
            random(
              1300,
              2000
            ),

          easing:
            'ease-in-out',

          fill:
            'forwards'

        }

      );


    try {

      await currentAnimation.finished;

    } catch (error) {}


    currentAnimation = null;


    if (caught) return;


    ghost.style.opacity =
      '0';


    await sleep(180);


    ghost.style.visibility =
      'hidden';

    ghost.style.pointerEvents =
      'none';

  }


  async function startGhost() {

    await sleep(1000);


    for (
      let i = 0;
      i < 4;
      i++
    ) {

      if (caught) return;


      await burst();


      if (caught) return;


      if (i < 3) {

        await sleep(
          random(
            300,
            800
          )
        );

      }

    }

  }


  /* ======================================================
     CATCH
  ====================================================== */

  function catchGhost() {

    if (caught) return;


    caught = true;


    if (currentAnimation) {

      currentAnimation.cancel();

    }


    ghost.style.opacity =
      '0';

    ghost.style.visibility =
      'hidden';

    ghost.style.pointerEvents =
      'none';


    setTheme(null);

    showStep(
      'gryphon-step-reveal'
    );


    modal.classList.add(
      'is-open'
    );


    modal.setAttribute(
      'aria-hidden',
      'false'
    );


    document.body.style.overflow =
      'hidden';

  }


  ghost.addEventListener(
    'pointerup',
    catchGhost
  );


  /* ======================================================
     REVEAL
  ====================================================== */

  revealButton.addEventListener(
    'click',
    function () {

      selectedPrize =
        pickPrize();


      typeText.textContent =
        selectedPrize.type;


      prizeTitle.textContent =
        selectedPrize.title;


      prizeCopy.textContent =
        selectedPrize.copy;


      setTheme(
        selectedPrize.type
      );


      showStep(
        'gryphon-step-prize'
      );

    }
  );


  /* ======================================================
     CLAIM — TEST ONLY
  ====================================================== */

  claimForm.addEventListener(
    'submit',
    function (event) {

      event.preventDefault();


      if (
        !email.checkValidity()
      ) {

        email.reportValidity();

        return;

      }


      const randomPart =
        Math.random()
          .toString(36)
          .substring(2, 8)
          .toUpperCase();


      codeText.textContent =
        'TEST-' +
        selectedPrize.prefix +
        '-' +
        randomPart;


      finalPrize.textContent =
        selectedPrize.title;


      showStep(
        'gryphon-step-code'
      );

    }
  );


  /* ======================================================
     COPY
  ====================================================== */

  copyButton.addEventListener(
    'click',
    async function () {

      try {

        await navigator.clipboard.writeText(
          codeText.textContent.trim()
        );


        copyButton.textContent =
          'COPIED';


        setTimeout(
          function () {

            copyButton.textContent =
              'COPY';

          },
          1200
        );


      } catch (error) {

        copyButton.textContent =
          'SELECT';

      }

    }
  );


  /* ======================================================
     CLOSE
  ====================================================== */

  function closeModal() {

    modal.classList.remove(
      'is-open'
    );


    modal.setAttribute(
      'aria-hidden',
      'true'
    );


    document.body.style.overflow =
      '';

  }


  closeButton.addEventListener(
    'click',
    closeModal
  );


  finishButton.addEventListener(
    'click',
    closeModal
  );


  document
    .querySelector(
      '.gryphon-spirit-backdrop'
    )
    .addEventListener(
      'click',
      closeModal
    );


  /* ======================================================
     START
  ====================================================== */

  startGhost();

});

</script>