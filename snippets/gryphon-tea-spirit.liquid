<!-- ======================================================
  GRYPHON AFTER DARK
  Tea Spirit Hunt - Prototype
======================================================= -->

<div
  id="gryphon-ghost"
  class="gryphon-ghost"
  aria-label="Catch Griffin"
  role="button"
  tabindex="0"
>
  <img
    src="https://cdn.shopify.com/s/files/1/0772/8142/7490/files/Griffin_Ghost.png?v=1788858668"
    alt="Catch Griffin"
    class="gryphon-ghost-image"
  >
</div>


<!-- ======================================================
  PRIZE MODAL
======================================================= -->

<div id="gryphon-spirit-modal" class="gryphon-spirit-modal" aria-hidden="true">

  <div class="gryphon-spirit-modal__backdrop"></div>

  <div class="gryphon-spirit-card">

    <button
      type="button"
      class="gryphon-spirit-close"
      id="gryphon-spirit-close"
      aria-label="Close"
    >
      ×
    </button>


    <!-- STEP 1: TRICK OR TREAT -->

    <div
      class="gryphon-spirit-step is-active"
      id="gryphon-step-reveal"
    >

      <p class="gryphon-spirit-eyebrow">
        GRYPHON AFTER DARK
      </p>

      <h2>
        TRICK OR TREAT?
      </h2>

      <p class="gryphon-spirit-copy">
        You caught a Gryphon Spirit.<br>
        Now reveal your fate.
      </p>

      <button
        type="button"
        class="gryphon-spirit-button"
        id="gryphon-reveal-button"
      >
        REVEAL MY FATE
      </button>

    </div>


    <!-- STEP 2: PRIZE -->

    <div
      class="gryphon-spirit-step"
      id="gryphon-step-prize"
    >

      <p
        class="gryphon-spirit-eyebrow"
        id="gryphon-prize-type"
      >
        TREAT
      </p>

      <h2 id="gryphon-prize-title">
        20% OFF
      </h2>

      <p
        class="gryphon-spirit-copy"
        id="gryphon-prize-message"
      >
        Griffin was feeling generous.
      </p>


      <div class="gryphon-claim">

        <h3>
          Claim your prize
        </h3>

        <p>
          Enter your email to unlock your unique code.
        </p>

        <form id="gryphon-claim-form">

          <input
            type="email"
            id="gryphon-claim-email"
            class="gryphon-spirit-email"
            placeholder="Email address"
            autocomplete="email"
            required
          >

          <label class="gryphon-consent">

            <input
              type="checkbox"
              id="gryphon-marketing-consent"
            >

            <span>
              Yes, send me Gryphon news, launches and offers.
            </span>

          </label>

          <button
            type="submit"
            class="gryphon-spirit-button"
          >
            UNLOCK MY CODE
          </button>

        </form>

      </div>

    </div>


    <!-- STEP 3: CODE -->

    <div
      class="gryphon-spirit-step"
      id="gryphon-step-code"
    >

      <p class="gryphon-spirit-eyebrow">
        YOUR PRIZE IS YOURS
      </p>

      <h2>
        YOUR UNIQUE CODE
      </h2>

      <div class="gryphon-code-box">

        <span id="gryphon-generated-code">
          TEST-GHOST-123456
        </span>

        <button
          type="button"
          id="gryphon-copy-code"
        >
          COPY
        </button>

      </div>

      <p
        class="gryphon-spirit-copy"
        id="gryphon-code-prize"
      ></p>

      <button
        type="button"
        class="gryphon-spirit-button"
        id="gryphon-finish-button"
      >
        CONTINUE SHOPPING
      </button>

    </div>

  </div>

</div>


<style>

  /* ======================================================
     GHOST
  ====================================================== */

  #gryphon-ghost {
    position: fixed;

    left: 0;
    top: 0;

    width: 125px;

    z-index: 9999998;

    cursor: pointer;

    opacity: 0;
    visibility: hidden;

    pointer-events: none;

    -webkit-tap-highlight-color: transparent;

    will-change: transform, opacity;
  }


  .gryphon-ghost-image {
    display: block;

    width: 85%;
    height: auto;

    pointer-events: none;

    user-select: none;

    -webkit-user-drag: none;
  }


  /* ======================================================
     MODAL
  ====================================================== */

  .gryphon-spirit-modal {
    position: fixed;

    inset: 0;

    z-index: 9999999;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 24px;

    opacity: 0;
    visibility: hidden;

    pointer-events: none;

    transition:
      opacity 250ms ease,
      visibility 250ms ease;
  }


  .gryphon-spirit-modal.is-open {
    opacity: 1;
    visibility: visible;

    pointer-events: auto;
  }


  .gryphon-spirit-modal__backdrop {
    position: absolute;

    inset: 0;

    background: rgba(20, 23, 18, 0.72);

    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
  }


  .gryphon-spirit-card {
    position: relative;

    width: min(440px, 100%);

    background: #333a2e;
    color: #f4f4f7;

    padding: 58px 44px 46px;

    text-align: center;

    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.25);

    overflow: hidden;
  }


  .gryphon-spirit-card::before {
    content: "";

    position: absolute;

    width: 220px;
    height: 220px;

    top: -130px;
    left: 50%;

    transform: translateX(-50%);

    border-radius: 50%;

    background: rgba(185, 182, 233, 0.16);

    filter: blur(40px);

    pointer-events: none;
  }


  .gryphon-spirit-close {
    position: absolute;

    top: 16px;
    right: 18px;

    width: 34px;
    height: 34px;

    padding: 0;

    border: 0;
    background: transparent;

    color: #f4f4f7;

    font-size: 27px;
    line-height: 1;

    cursor: pointer;
  }


  /* ======================================================
     MODAL CONTENT
  ====================================================== */

  .gryphon-spirit-step {
    display: none;
  }


  .gryphon-spirit-step.is-active {
    display: block;

    animation: gryphonStepIn 400ms ease forwards;
  }


  .gryphon-spirit-eyebrow {
    margin: 0 0 18px;

    font-size: 11px;
    line-height: 1.2;

    letter-spacing: 0.18em;

    text-transform: uppercase;

    opacity: 0.75;
  }


  .gryphon-spirit-card h2 {
    margin: 0 0 18px;

    color: #f4f4f7;

    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);

    font-size: clamp(30px, 5vw, 45px);
    line-height: 1;

    letter-spacing: 0.02em;
  }


  .gryphon-spirit-copy {
    margin: 0 auto 30px;

    max-width: 330px;

    font-size: 14px;
    line-height: 1.55;

    opacity: 0.88;
  }


  .gryphon-spirit-button {
    width: 100%;

    min-height: 50px;

    padding: 14px 22px;

    border: 1px solid #f4f4f7;

    background: #f4f4f7;
    color: #333a2e;

    font-family: var(--font-body-family);

    font-size: 12px;

    letter-spacing: 0.12em;

    cursor: pointer;

    transition:
      background 180ms ease,
      color 180ms ease;
  }


  .gryphon-spirit-button:hover {
    background: transparent;

    color: #f4f4f7;
  }


  /* ======================================================
     CLAIM FORM
  ====================================================== */

  .gryphon-claim {
    margin-top: 34px;

    padding-top: 28px;

    border-top: 1px solid rgba(244, 244, 247, 0.22);

    text-align: left;
  }


  .gryphon-claim h3 {
    margin: 0 0 7px;

    color: #f4f4f7;

    font-size: 18px;
    font-weight: 600;
  }


  .gryphon-claim > p {
    margin: 0 0 19px;

    font-size: 13px;
    line-height: 1.5;

    opacity: 0.82;
  }


  .gryphon-spirit-email {
    display: block;

    width: 100%;

    height: 50px;

    padding: 0 15px;

    border: 1px solid rgba(244, 244, 247, 0.55);

    border-radius: 0;

    background: transparent;

    color: #f4f4f7;

    font-family: var(--font-body-family);
    font-size: 14px;

    outline: none;
  }


  .gryphon-spirit-email::placeholder {
    color: rgba(244, 244, 247, 0.55);
  }


  .gryphon-spirit-email:focus {
    border-color: #f4f4f7;
  }


  .gryphon-consent {
    display: flex;
    align-items: flex-start;

    gap: 10px;

    margin: 16px 0 22px;

    cursor: pointer;
  }


  .gryphon-consent input {
    width: 15px;
    height: 15px;

    margin: 2px 0 0;

    flex: 0 0 auto;
  }


  .gryphon-consent span {
    font-size: 12px;
    line-height: 1.45;

    opacity: 0.85;
  }


  /* ======================================================
     CODE
  ====================================================== */

  .gryphon-code-box {
    display: flex;
    align-items: stretch;

    width: 100%;

    margin: 28px 0 22px;

    border: 1px solid rgba(244, 244, 247, 0.7);
  }


  .gryphon-code-box span {
    flex: 1;

    display: flex;
    align-items: center;

    padding: 15px;

    font-size: 14px;
    letter-spacing: 0.08em;

    text-align: left;

    overflow-wrap: anywhere;
  }


  .gryphon-code-box button {
    flex: 0 0 auto;

    padding: 0 17px;

    border: 0;
    border-left: 1px solid rgba(244, 244, 247, 0.7);

    background: transparent;

    color: #f4f4f7;

    font-size: 10px;
    letter-spacing: 0.12em;

    cursor: pointer;
  }


  /* ======================================================
     ANIMATION
  ====================================================== */

  @keyframes gryphonStepIn {

    from {
      opacity: 0;
      transform: translateY(8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }

  }


  /* ======================================================
     MOBILE
  ====================================================== */

  @media screen and (max-width: 749px) {

    #gryphon-ghost {
      width: 100px;
    }


    .gryphon-spirit-modal {
      padding: 16px;
    }


    .gryphon-spirit-card {
      width: 100%;

      padding:
        52px
        24px
        34px;
    }


    .gryphon-spirit-card h2 {
      font-size: 34px;
    }

  }

</style>


<script>

document.addEventListener('DOMContentLoaded', function () {

  /* ======================================================
     ELEMENTS
  ====================================================== */

  const ghost =
    document.getElementById('gryphon-ghost');

  const modal =
    document.getElementById('gryphon-spirit-modal');

  const closeButton =
    document.getElementById('gryphon-spirit-close');

  const revealButton =
    document.getElementById('gryphon-reveal-button');

  const claimForm =
    document.getElementById('gryphon-claim-form');

  const emailInput =
    document.getElementById('gryphon-claim-email');

  const consentInput =
    document.getElementById('gryphon-marketing-consent');

  const copyButton =
    document.getElementById('gryphon-copy-code');

  const finishButton =
    document.getElementById('gryphon-finish-button');

  const prizeType =
    document.getElementById('gryphon-prize-type');

  const prizeTitle =
    document.getElementById('gryphon-prize-title');

  const prizeMessage =
    document.getElementById('gryphon-prize-message');

  const codeOutput =
    document.getElementById('gryphon-generated-code');

  const codePrize =
    document.getElementById('gryphon-code-prize');


  if (!ghost || !modal) return;


  /* ======================================================
     TEST SETTINGS
  ====================================================== */

  const INITIAL_DELAY = 1000;

  const TOTAL_BURSTS = 4;

  const POP_GAP_MIN = 300;
  const POP_GAP_MAX = 800;

  const BURST_MIN = 1300;
  const BURST_MAX = 2000;


  let caught = false;
  let currentAnimation = null;
  let selectedPrize = null;


  /* ======================================================
     TEST PRIZES

     WE WILL REPLACE THESE LATER WITH THE REAL REWARDS
  ====================================================== */

  const prizes = [

    {
      type: 'TRICK',
      title: '5% OFF',
      message: 'Griffin almost got away with it.',
      weight: 30,
      prefix: 'GHOST5'
    },

    {
      type: 'TRICK',
      title: 'MYSTERY TEA SACHET',
      message: 'A little something was left behind.',
      weight: 20,
      prefix: 'SACHET'
    },

    {
      type: 'TREAT',
      title: 'FREE SHIPPING',
      message: 'Your next tea delivery is on Griffin.',
      weight: 18,
      prefix: 'SHIP'
    },

    {
      type: 'TREAT',
      title: '$10 OFF',
      message: 'A treat worth catching.',
      weight: 15,
      prefix: 'TEN'
    },

    {
      type: 'TREAT',
      title: 'FREE COLLAGEN POUCH',
      message: 'Something extra is coming your way.',
      weight: 10,
      prefix: 'COLLAGEN'
    },

    {
      type: 'TREAT',
      title: '20% OFF',
      message: 'Griffin was feeling generous.',
      weight: 7,
      prefix: 'GHOST20'
    }

  ];


  /* ======================================================
     HELPERS
  ====================================================== */

  function random(min, max) {
    return Math.random() * (max - min) + min;
  }


  function sleep(ms) {
    return new Promise(function (resolve) {
      setTimeout(resolve, ms);
    });
  }


  function showStep(id) {

    document
      .querySelectorAll('.gryphon-spirit-step')
      .forEach(function (step) {
        step.classList.remove('is-active');
      });


    const nextStep =
      document.getElementById(id);


    if (nextStep) {
      nextStep.classList.add('is-active');
    }

  }


  /* ======================================================
     PRIZE PICKER
  ====================================================== */

  function pickPrize() {

    const totalWeight =
      prizes.reduce(function (total, prize) {
        return total + prize.weight;
      }, 0);


    let roll =
      Math.random() * totalWeight;


    for (const prize of prizes) {

      roll -= prize.weight;

      if (roll <= 0) {
        return prize;
      }

    }


    return prizes[0];

  }


  /* ======================================================
     RANDOM GHOST MOVEMENT
  ====================================================== */

  function getSpawnPoint() {

    const ghostWidth =
      ghost.offsetWidth || 125;

    const ghostHeight =
      ghost.offsetHeight || 140;


    return {

      x: random(
        15,
        Math.max(
          20,
          window.innerWidth - ghostWidth - 20
        )
      ),

      y: random(
        90,
        Math.max(
          100,
          window.innerHeight - ghostHeight - 40
        )
      )

    };

  }


  function buildZigZagFrames(start) {

    const frames = [];

    let x = start.x;
    let y = start.y;


    frames.push({
      transform:
        `translate3d(${x}px, ${y}px, 0) rotate(-5deg)`
    });


    const steps =
      Math.floor(random(4, 7));


    for (let i = 1; i <= steps; i++) {

      x += random(-150, 150);

      y +=
        i % 2 === 0
          ? random(45, 105)
          : random(-105, -45);


      x =
        Math.max(
          15,
          Math.min(
            window.innerWidth - 125,
            x
          )
        );


      y =
        Math.max(
          80,
          Math.min(
            window.innerHeight - 150,
            y
          )
        );


      frames.push({

        offset: i / steps,

        transform:
          `translate3d(${x}px, ${y}px, 0) rotate(${random(-11, 11)}deg)`

      });

    }


    return frames;

  }


  async function runBurst() {

    const spawn =
      getSpawnPoint();


    ghost.style.visibility =
      'visible';

    ghost.style.pointerEvents =
      'auto';

    ghost.style.opacity =
      '0';

    ghost.style.transform =
      `translate3d(${spawn.x}px, ${spawn.y}px, 0)`;


    ghost.offsetHeight;


    ghost.style.transition =
      'opacity 180ms ease';

    ghost.style.opacity =
      '1';


    currentAnimation =
      ghost.animate(

        buildZigZagFrames(spawn),

        {
          duration:
            random(
              BURST_MIN,
              BURST_MAX
            ),

          easing:
            'ease-in-out',

          fill:
            'forwards'
        }

      );


    try {

      await currentAnimation.finished;

    } catch (error) {}


    currentAnimation = null;


    if (caught) return;


    ghost.style.opacity =
      '0';


    await sleep(200);


    ghost.style.visibility =
      'hidden';

    ghost.style.pointerEvents =
      'none';

  }


  async function runGhostSequence() {

    await sleep(INITIAL_DELAY);


    for (
      let i = 0;
      i < TOTAL_BURSTS;
      i++
    ) {

      if (caught) return;


      await runBurst();


      if (caught) return;


      if (
        i <
        TOTAL_BURSTS - 1
      ) {

        await sleep(
          random(
            POP_GAP_MIN,
            POP_GAP_MAX
          )
        );

      }

    }

  }


  /* ======================================================
     CATCH
  ====================================================== */

  function catchGhost() {

    if (caught) return;


    caught = true;


    if (currentAnimation) {

      currentAnimation.cancel();

      currentAnimation = null;

    }


    ghost.style.opacity =
      '0';

    ghost.style.visibility =
      'hidden';

    ghost.style.pointerEvents =
      'none';


    showStep(
      'gryphon-step-reveal'
    );


    modal.classList.add(
      'is-open'
    );


    modal.setAttribute(
      'aria-hidden',
      'false'
    );


    document.body.style.overflow =
      'hidden';

  }


  ghost.addEventListener(
    'pointerup',
    catchGhost
  );


  ghost.addEventListener(
    'keydown',
    function (event) {

      if (
        event.key === 'Enter' ||
        event.key === ' '
      ) {

        event.preventDefault();

        catchGhost();

      }

    }
  );


  /* ======================================================
     REVEAL PRIZE
  ====================================================== */

  revealButton.addEventListener(
    'click',
    function () {

      selectedPrize =
        pickPrize();


      prizeType.textContent =
        selectedPrize.type;


      prizeTitle.textContent =
        selectedPrize.title;


      prizeMessage.textContent =
        selectedPrize.message;


      showStep(
        'gryphon-step-prize'
      );

    }
  );


  /* ======================================================
     CLAIM

     CURRENTLY TEST ONLY.
     EMAIL IS NOT BEING SENT ANYWHERE YET.
  ====================================================== */

  claimForm.addEventListener(
    'submit',
    function (event) {

      event.preventDefault();


      if (
        !emailInput.checkValidity()
      ) {

        emailInput.reportValidity();

        return;

      }


      const randomPart =
        Math.random()
          .toString(36)
          .substring(2, 8)
          .toUpperCase();


      const testCode =
        'TEST-' +
        selectedPrize.prefix +
        '-' +
        randomPart;


      codeOutput.textContent =
        testCode;


      codePrize.textContent =
        selectedPrize.title;


      /*
        We can access these later when
        connecting Klaviyo:

        emailInput.value
        consentInput.checked
      */


      showStep(
        'gryphon-step-code'
      );

    }
  );


  /* ======================================================
     COPY CODE
  ====================================================== */

  copyButton.addEventListener(
    'click',
    async function () {

      const code =
        codeOutput.textContent.trim();


      try {

        await navigator.clipboard.writeText(
          code
        );


        copyButton.textContent =
          'COPIED';


        setTimeout(
          function () {

            copyButton.textContent =
              'COPY';

          },
          1500
        );


      } catch (error) {

        copyButton.textContent =
          'SELECT CODE';

      }

    }
  );


  /* ======================================================
     CLOSE
  ====================================================== */

  function closeModal() {

    modal.classList.remove(
      'is-open'
    );


    modal.setAttribute(
      'aria-hidden',
      'true'
    );


    document.body.style.overflow =
      '';

  }


  closeButton.addEventListener(
    'click',
    closeModal
  );


  finishButton.addEventListener(
    'click',
    closeModal
  );


  modal
    .querySelector(
      '.gryphon-spirit-modal__backdrop'
    )
    .addEventListener(
      'click',
      closeModal
    );


  /* ======================================================
     START
  ====================================================== */

  runGhostSequence();

});
</script>