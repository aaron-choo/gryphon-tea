<div id="gryphon-ghost">
  <img
    src="https://cdn.shopify.com/s/files/1/0772/8142/7490/files/Griffin_Ghost.png?v=1788858668"
    alt="Catch Griffin"
    class="gryphon-ghost-image"
  >
</div>

<div id="gryphon-gotcha">
  GOTCHA.
</div>

<style>

    .gryphon-ghost-image {
  display: block;
  width: 70%;
  height: auto;
  pointer-events: none;
}

  #gryphon-ghost {
     position: fixed;
  left: 0;
  top: 0;
  width: 100px;
  height: 120px;
  z-index: 9999999;
  cursor: pointer;
  display: block;
  opacity: 0;
  pointer-events: auto;
}

#gryphon-ghost.flying {
  display: block;
  animation: gryphonGhostFly 6s cubic-bezier(.45,.05,.55,.95) forwards;
}

  #gryphon-gotcha {
    display: none;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 10000000;

    background: #333a2e;
    color: white;
    padding: 18px 30px;

    font-size: 18px;
    letter-spacing: 2px;
  }

</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const ghost = document.getElementById('gryphon-ghost');
    const gotcha = document.getElementById('gryphon-gotcha');

    if (!ghost) return;

    const INITIAL_DELAY = 1000;   // for testing first
    const TOTAL_BURSTS = 4;       // how many times it appears
    const POP_GAP_MIN = 250;      // disappear gap before reappearing
    const POP_GAP_MAX = 700;
    const BURST_DURATION_MIN = 1200;
    const BURST_DURATION_MAX = 1900;

    let caught = false;
    let currentAnimation = null;

    function rand(min, max) {
      return Math.random() * (max - min) + min;
    }

    function sleep(ms) {
      return new Promise(resolve => setTimeout(resolve, ms));
    }

    function getSpawnPoint() {
      return {
        x: rand(20, Math.max(20, window.innerWidth - 140)),
        y: rand(100, Math.max(100, window.innerHeight - 180))
      };
    }

    function buildZigZagFrames(start) {
      const frames = [];
      let x = start.x;
      let y = start.y;

      frames.push({
        transform: `translate3d(${x}px, ${y}px, 0) rotate(-8deg)`
      });

      const steps = Math.floor(rand(4, 7));

      for (let i = 1; i <= steps; i++) {
        x += rand(-140, 140);
        y += i % 2 === 0 ? rand(50, 110) : rand(-110, -50);

        x = Math.max(20, Math.min(window.innerWidth - 120, x));
        y = Math.max(90, Math.min(window.innerHeight - 140, y));

        frames.push({
          offset: i / steps,
          transform: `translate3d(${x}px, ${y}px, 0) rotate(${rand(-12, 12)}deg)`
        });
      }

      return {
        frames: frames,
        endX: x,
        endY: y
      };
    }

    async function doBurst() {
      const spawn = getSpawnPoint();

      ghost.style.display = 'block';
      ghost.style.opacity = '0';
      ghost.style.transform = `translate3d(${spawn.x}px, ${spawn.y}px, 0)`;

      // force repaint
      ghost.offsetHeight;

      ghost.style.opacity = '1';

      const path = buildZigZagFrames(spawn);

      currentAnimation = ghost.animate(path.frames, {
        duration: rand(BURST_DURATION_MIN, BURST_DURATION_MAX),
        easing: 'ease-in-out',
        fill: 'forwards'
      });

      try {
        await currentAnimation.finished;
      } catch (e) {}

      currentAnimation = null;

      ghost.style.transform = `translate3d(${path.endX}px, ${path.endY}px, 0)`;

      if (caught) return;

      ghost.style.opacity = '0';
      await sleep(220);
    }

    async function runSequence() {
      await sleep(INITIAL_DELAY);

      for (let i = 0; i < TOTAL_BURSTS; i++) {
        if (caught) return;

        await doBurst();

        if (caught) return;

        if (i < TOTAL_BURSTS - 1) {
          await sleep(rand(POP_GAP_MIN, POP_GAP_MAX));
        }
      }

      ghost.style.display = 'none';
    }

    function catchGhost() {
      if (caught) return;

      caught = true;

      if (currentAnimation) {
        currentAnimation.cancel();
        currentAnimation = null;
      }

      ghost.style.opacity = '0';

      setTimeout(function () {
        ghost.style.display = 'none';
      }, 180);

      if (gotcha) {
        gotcha.style.display = 'block';

        setTimeout(function () {
          gotcha.style.display = 'none';
        }, 1500);
      }
    }

    ghost.addEventListener('click', catchGhost);
    ghost.addEventListener('touchstart', catchGhost, { passive: true });

    runSequence();
  });
</script>