/* ======================================================
   CLAIM REWARD

   TEST MODE FOR NOW.
   Later this function will call the secure backend.
======================================================= */

async function claimReward() {

  const claimData = {
    email: email.value.trim(),
    marketingConsent:
      consentCheckbox
        ? consentCheckbox.checked
        : false,
    prizeId: selectedPrize.id
  };


  console.log(
    'TEST CLAIM:',
    claimData
  );


  /* Fake backend response for now */

  return {
    status: 'success',
    prizeId: selectedPrize.id,
    code: (
      selectedPrize.rewardType === 'loyalty-immediate' ||
      selectedPrize.rewardType === 'loyalty-double'
    )
      ? null
      : makeTestCode(selectedPrize),

    loyaltyMember:
      campaignConfig.campaign.testLoyaltyMember
  };

}

/* ======================================================
   CONFIRMATION SCREEN — TEST MODE
======================================================= */

function makeTestCode(prize) {

  const randomPart =
    Math.random()
      .toString(36)
      .substring(2, 8)
      .toUpperCase();


  return (
    'TEST-' +
    prize.id
      .replace(/[^a-z0-9]/gi, '')
      .toUpperCase() +
    '-' +
    randomPart
  );

}


function showRewardConfirmation(
  claimResponse
) {

  if (!selectedPrize) {
    return;
  }


  /* Reset everything first */

  confirmLabel.textContent =
    'CLAIMED!';

  finalPrize.textContent =
    selectedPrize.title;

  confirmCopy.textContent =
    campaignConfig.copy.genericCodeInstruction;

  confirmTnc.textContent =
    selectedPrize.tnc || '';

  codeWrap.hidden =
    false;

  loyaltyAction.hidden =
    true;

  finishButton.hidden =
    false;

  finishButton.textContent =
    'CONTINUE SHOPPING';


  /* =========================================
     NORMAL CODE REWARDS
  ========================================= */

  if (
    selectedPrize.rewardType === 'discount' ||
    selectedPrize.rewardType === 'shipping' ||
    selectedPrize.rewardType === 'physical'
  ) {

codeText.textContent =
  claimResponse.code;

  }


  /* =========================================
     SHOPPING CREDIT
  ========================================= */

  else if (
    selectedPrize.rewardType === 'credit'
  ) {

    codeText.textContent =
      makeTestCode(selectedPrize);


    if (
      selectedPrize.id === 'treat-golden'
    ) {

      confirmLabel.textContent =
        'YOU FOUND THE GOLDEN TREAT!';

      confirmCopy.textContent =
        'Psst... You must be Rosie’s favourite! Use this code on your next purchase.';

    } else {

      confirmLabel.textContent =
        '$20 IS YOURS!';

      confirmCopy.textContent =
        'Rosie must really like you. Use this code on your next purchase.';

    }

  }


  /* =========================================
     50 BONUS POINTS — IMMEDIATE
  ========================================= */

  else if (
    selectedPrize.rewardType === 'loyalty-immediate'
  ) {

    codeWrap.hidden =
      true;


if (
  claimResponse.loyaltyMember
) {

      confirmLabel.textContent =
        '50 POINTS ARE YOURS!';

      confirmCopy.textContent =
        'Your bonus points have been added to your Gryphon loyalty account.';

      loyaltyAction.textContent =
        'VIEW MY REWARDS';

    } else {

      confirmLabel.textContent =
        'YOUR 50 POINTS ARE WAITING';

      confirmCopy.textContent =
        'Create a Gryphon loyalty account using this email to receive your bonus points.';

      loyaltyAction.textContent =
        'CREATE MY ACCOUNT';

    }


    loyaltyAction.hidden =
      false;

    finishButton.hidden =
      true;

  }


  /* =========================================
     DOUBLE LOYALTY POINTS
  ========================================= */

  else if (
    selectedPrize.rewardType === 'loyalty-double'
  ) {

    codeWrap.hidden =
      true;


if (
  claimResponse.loyaltyMember
) {

      confirmLabel.textContent =
        '2× POINTS UNLOCKED!';

      confirmCopy.textContent =
        'Your next purchase using this email will earn double loyalty points.';

      loyaltyAction.hidden =
        true;

      finishButton.hidden =
        false;

    } else {

      confirmLabel.textContent =
        'YOUR 2× POINTS ARE WAITING';

      confirmCopy.textContent =
        'Create a Gryphon loyalty account using this email before your next purchase to activate your reward.';

      loyaltyAction.textContent =
        'CREATE MY ACCOUNT';

      loyaltyAction.hidden =
        false;

      finishButton.hidden =
        true;

    }

  }


  showStep(
    'gryphon-step-code'
  );

}

  /* ======================================================
     CLAIM — TEST ONLY
  ====================================================== */

claimForm.addEventListener(
  'submit',
  async function (event) {

    event.preventDefault();


    if (
      !email.checkValidity()
    ) {

      email.reportValidity();

      return;

    }


    try {

      const claimResponse =
        await claimReward();


      if (
        claimResponse.status === 'success'
      ) {

        showRewardConfirmation(
          claimResponse
        );

      }


    } catch (error) {

      console.error(
        'Gryphon Halloween claim error:',
        error
      );

    }

  }
);


  /* ======================================================
     COPY
  ====================================================== */

  copyButton.addEventListener(
    'click',
    async function () {

      try {

        await navigator.clipboard.writeText(
          codeText.textContent.trim()
        );


        copyButton.textContent =
          'COPIED';


        setTimeout(
          function () {

            copyButton.textContent =
              'COPY';

          },
          1200
        );


      } catch (error) {

        copyButton.textContent =
          'SELECT';

      }

    }
  );


  /* ======================================================
     CLOSE
  ====================================================== */

  function closeModal() {

    modal.classList.remove(
      'is-open'
    );


    modal.setAttribute(
      'aria-hidden',
      'true'
    );


    document.body.style.overflow =
      '';

  }


  closeButton.addEventListener(
    'click',
    closeModal
  );


  finishButton.addEventListener(
    'click',
    closeModal
  );


  document
    .querySelector(
      '.gryphon-spirit-backdrop'
    )
    .addEventListener(
      'click',
      closeModal
    );

