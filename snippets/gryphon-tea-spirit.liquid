  closeClue();

  markHuntStarted();

  huntStarted = true;

  maybeStartGhost();

}

  function random(min, max) {
    return Math.random() * (max - min) + min;
  }


  function sleep(ms) {

    return new Promise(function (resolve) {

      setTimeout(resolve, ms);

    });

  }


  function showStep(id) {

    document
      .querySelectorAll('.gryphon-step')
      .forEach(function (step) {

        step.classList.remove('is-active');

      });


    const target =
      document.getElementById(id);


    if (target) {

      target.classList.add('is-active');

    }

  }


  function setTheme(type) {

    card.classList.remove(
      'gryphon-theme-neutral',
      'gryphon-theme-trick',
      'gryphon-theme-treat'
    );


    if (type === 'TRICK') {

      card.classList.add(
        'gryphon-theme-trick'
      );

    } else if (type === 'TREAT') {

      card.classList.add(
        'gryphon-theme-treat'
      );

    } else {

      card.classList.add(
        'gryphon-theme-neutral'
      );

    }

  }


  function pickPrize() {

    const total =
      prizes.reduce(function (sum, prize) {

        return sum + prize.weight;

      }, 0);


    let roll =
      Math.random() * total;


    for (const prize of prizes) {

      roll -= prize.weight;


      if (roll <= 0) {

        return prize;

      }

    }


    return prizes[0];

  }


  /* ======================================================
     GHOST MOVEMENT
  ====================================================== */

  function getSpawn() {

    const width =
      ghost.offsetWidth || 120;


    const height =
      ghost.offsetHeight || 120;


    return {

      x: random(
        15,
        Math.max(
          20,
          window.innerWidth - width - 20
        )
      ),

      y: random(
        90,
        Math.max(
          100,
          window.innerHeight - height - 40
        )
      )

    };

  }


  function buildPath(start) {

    const frames = [];

    let x = start.x;
    let y = start.y;


    frames.push({

      transform:
        `translate3d(${x}px, ${y}px, 0) rotate(-5deg)`

    });


    const steps =
      Math.floor(
        random(4, 7)
      );


    for (
      let i = 1;
      i <= steps;
      i++
    ) {

      x +=
        random(-150, 150);


      y +=
        i % 2 === 0
          ? random(45, 105)
          : random(-105, -45);


      x =
        Math.max(
          15,
          Math.min(
            window.innerWidth - 120,
            x
          )
        );


      y =
        Math.max(
          80,
          Math.min(
            window.innerHeight - 140,
            y
          )
        );


      frames.push({

        offset:
          i / steps,

        transform:
          `translate3d(${x}px, ${y}px, 0) rotate(${random(-11, 11)}deg)`

      });

    }


    return frames;

  }


  async function burst() {

    const spawn =
      getSpawn();


    ghost.style.visibility =
      'visible';

    ghost.style.pointerEvents =
      'auto';

    ghost.style.opacity =
      '0';

    ghost.style.transform =
      `translate3d(${spawn.x}px, ${spawn.y}px, 0)`;


    ghost.offsetHeight;


    ghost.style.transition =
      'opacity 180ms ease';

    ghost.style.opacity =
      '1';


    currentAnimation =
      ghost.animate(

        buildPath(spawn),

        {

          duration:
            random(
              1300,
              2000
            ),

          easing:
            'ease-in-out',

          fill:
            'forwards'

        }

      );


    try {

      await currentAnimation.finished;

    } catch (error) {}


    currentAnimation = null;


    if (caught) return;


    ghost.style.opacity =
      '0';


    await sleep(180);


    ghost.style.visibility =
      'hidden';

    ghost.style.pointerEvents =
      'none';

  }


  async function startGhost() {

    await sleep(1000);


    for (
      let i = 0;
      i < 4;
      i++
    ) {

      if (caught) return;


      await burst();


      if (caught) return;


      if (i < 3) {

        await sleep(
          random(
            300,
            800
          )
        );

      }

    }

  }


  /* ======================================================
     CATCH
  ====================================================== */

  function catchGhost() {

    if (caught) return;


    caught = true;


    if (currentAnimation) {

      currentAnimation.cancel();

    }


    ghost.style.opacity =
      '0';

    ghost.style.visibility =
      'hidden';

    ghost.style.pointerEvents =
      'none';


    setTheme(null);

    showStep(
      'gryphon-step-reveal'
    );


    modal.classList.add(
      'is-open'
    );


    modal.setAttribute(
      'aria-hidden',
      'false'
    );


    document.body.style.overflow =
      'hidden';

  }


  ghost.addEventListener(
    'pointerup',
    catchGhost
  );


