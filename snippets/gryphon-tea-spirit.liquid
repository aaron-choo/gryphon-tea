<div id="gryphon-ghost">
  <div class="gryphon-ghost-body">
    <div class="gryphon-eye left"></div>
    <div class="gryphon-eye right"></div>
    <div class="gryphon-tag">GRYPHON</div>
  </div>
</div>

<div id="gryphon-gotcha">
  GOTCHA.
</div>

<style>
  #gryphon-ghost {
    position: fixed;
    left: -130px;
    top: 40vh;
    width: 100px;
    height: 120px;
    z-index: 9999999;
    cursor: pointer;
    display: none;
  }

#gryphon-ghost.flying {
  display: block;
  animation: gryphonGhostFly 6s cubic-bezier(.45,.05,.55,.95) forwards;
}

  .gryphon-ghost-body {
    position: relative;
    width: 75px;
    height: 90px;
    margin: auto;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 50% 50% 40% 40%;
    box-shadow:
      0 0 25px rgba(185, 182, 233, 0.9),
      0 0 55px rgba(237, 207, 208, 0.7);
  }

  .gryphon-eye {
    position: absolute;
    top: 30px;
    width: 6px;
    height: 9px;
    background: #333a2e;
    border-radius: 50%;
  }

  .gryphon-eye.left {
    left: 23px;
  }

  .gryphon-eye.right {
    right: 23px;
  }

  .gryphon-tag {
    position: absolute;
    top: 67px;
    left: 48px;
    padding: 6px 8px;
    background: #5e6b47;
    color: white;
    font-size: 6px;
    letter-spacing: 1px;
    transform: rotate(-8deg);
  }

  #gryphon-gotcha {
    display: none;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 10000000;

    background: #333a2e;
    color: white;
    padding: 18px 30px;

    font-size: 18px;
    letter-spacing: 2px;
  }

@keyframes gryphonGhostFly {
  0% {
    transform: translateX(0) translateY(0) rotate(-6deg);
  }

  10% {
    transform: translateX(12vw) translateY(-45px) rotate(5deg);
  }

  20% {
    transform: translateX(24vw) translateY(28px) rotate(-4deg);
  }

  30% {
    transform: translateX(36vw) translateY(-55px) rotate(6deg);
  }

  40% {
    transform: translateX(48vw) translateY(18px) rotate(-5deg);
  }

  50% {
    transform: translateX(60vw) translateY(-42px) rotate(4deg);
  }

  60% {
    transform: translateX(72vw) translateY(34px) rotate(-6deg);
  }

  70% {
    transform: translateX(84vw) translateY(-30px) rotate(5deg);
  }

  80% {
    transform: translateX(96vw) translateY(22px) rotate(-4deg);
  }

  90% {
    transform: translateX(108vw) translateY(-18px) rotate(3deg);
  }

  100% {
    transform: translateX(calc(100vw + 250px)) translateY(10px) rotate(0deg);
  }
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const ghost = document.getElementById('gryphon-ghost');
    const gotcha = document.getElementById('gryphon-gotcha');

    if (!ghost) return;

    setTimeout(function () {
      ghost.classList.add('flying');
    }, 1000);

    ghost.addEventListener('click', function () {
      ghost.style.display = 'none';

      gotcha.style.display = 'block';

      setTimeout(function () {
        gotcha.style.display = 'none';
      }, 1500);
    });
  });
</script>