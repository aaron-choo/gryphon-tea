  const HUNT_STORAGE_KEY =
  'gryphonHalloweenHuntDate';

const CLUE_SEEN_STORAGE_KEY =
  'gryphonHalloweenClueSeenDate';


function hasStartedHuntToday() {

  return (
    sessionStorage.getItem(
      HUNT_STORAGE_KEY
    ) === getCampaignDate()
  );

}


function markHuntStarted() {

  sessionStorage.setItem(
    HUNT_STORAGE_KEY,
    getCampaignDate()
  );

}


function hasSeenClueToday() {

  return (
    sessionStorage.getItem(
      CLUE_SEEN_STORAGE_KEY
    ) === getCampaignDate()
  );

}


function markClueSeen() {

  sessionStorage.setItem(
    CLUE_SEEN_STORAGE_KEY,
    getCampaignDate()
  );

}

function getCampaignDate() {

  if (
    campaignConfig.campaign.testMode &&
    campaignConfig.campaign.testDate
  ) {
    return campaignConfig.campaign.testDate;
  }

  const formatter =
    new Intl.DateTimeFormat(
      'en-CA',
      {
        timeZone: 'Asia/Singapore',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit'
      }
    );

  return formatter.format(new Date());
}

function getTodayClue() {

  const date =
    getCampaignDate();

  return campaignConfig.clues[date] || null;

}

function pageMatchesGhostTarget(
  targetKey
) {

  const target =
    ghostTargets[targetKey];

  if (!target) {
    return false;
  }

  const currentPath =
    window.location.pathname.toLowerCase();

  return target.paths.some(
    function (path) {

      return currentPath.includes(
        path.toLowerCase()
      );

    }
  );

}


function maybeStartGhost() {

  const todayClue =
    getTodayClue();

  if (!todayClue) {
    return;
  }

  if (!hasStartedHuntToday()) {
    return;
  }

  if (
    !pageMatchesGhostTarget(
      todayClue.targetKey
    )
  ) {
    return;
  }

  startGhost();

}


let huntStarted = false;


