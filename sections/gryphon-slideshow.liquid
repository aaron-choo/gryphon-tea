{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
<style>
  #shopify-section-{{ section.id }} .gryphon-slide {
  cursor: pointer;
}

/* Keep actual buttons behaving normally */
#shopify-section-{{ section.id }} .gryphon-slide a,
#shopify-section-{{ section.id }} .gryphon-slide button {
  cursor: pointer;
}
  /* ========================================
     IMAGE SWAP
     ======================================== */

#shopify-section-{{ section.id }} .gryphon-mobile-image,
#shopify-section-{{ section.id }} .gryphon-mobile-video {
  display: none !important;
}

@media screen and (max-width: 749px) {

  /* IMAGE SWAP */
  #shopify-section-{{ section.id }} .has-mobile-image .gryphon-desktop-image {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .has-mobile-image .gryphon-mobile-image {
    display: block !important;
  }

  /* VIDEO SWAP */
  #shopify-section-{{ section.id }} .has-mobile-video .gryphon-desktop-video {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .has-mobile-video .gryphon-mobile-video {
    display: block !important;
  }
}


  /* ========================================
     DESKTOP SLIDE SIZE — 1920 x 650
     ======================================== */

  @media screen and (min-width: 750px) {

    #shopify-section-{{ section.id }} #Slider-{{ section.id }} {
      width: 100%;
      height: auto !important;
      min-height: 0 !important;
      aspect-ratio: 1920 / 650;
    }

    #shopify-section-{{ section.id }} .gryphon-slide {
      height: 100% !important;
      min-height: 0 !important;
      position: relative;
    }


    /* BRANDING — FULL IMAGE */

    #shopify-section-{{ section.id }} .gryphon-slide--branding .slideshow__media {
      position: absolute !important;
      inset: 0 !important;
      width: 100% !important;
      height: 100% !important;
    }

#shopify-section-{{ section.id }} .gryphon-slide--branding .slideshow__media img,
#shopify-section-{{ section.id }} .gryphon-slide--branding .slideshow__media video {
  width: 100% !important;
  height: 100% !important;
  object-fit: contain !important;
  display: block;
}

    #shopify-section-{{ section.id }} .gryphon-slide--branding .slideshow__text-wrapper {
      display: none !important;
    }


    /* PROMO — 50 / 50 */

    #shopify-section-{{ section.id }} .gryphon-slide--promo .slideshow__media {
      position: absolute !important;
      top: 0 !important;
      bottom: 0 !important;
      left: 0 !important;
      right: auto !important;
      width: 50% !important;
      height: 100% !important;
    }

    #shopify-section-{{ section.id }} .gryphon-slide--promo .slideshow__media img {
      width: 100% !important;
      height: 100% !important;
      object-fit: contain !important;
    }

    #shopify-section-{{ section.id }} .gryphon-slide--promo .slideshow__text-wrapper {
      position: absolute !important;
      top: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      left: auto !important;
      width: 50% !important;
      height: 100% !important;
      max-width: none !important;
      margin: 0 !important;
      padding: 0 !important;
      background: var(--gryphon-promo-background) !important;
    }

    #shopify-section-{{ section.id }} .gryphon-slide--promo .slideshow__text {
      width: 100% !important;
      max-width: none !important;
      height: 100% !important;
      min-height: 0 !important;
      margin: 0 !important;
      padding: var(--gryphon-desktop-padding) 8% !important;
      border-radius: 0 !important;
      background: var(--gryphon-promo-background) !important;
      display: flex !important;
      flex-direction: column;
      justify-content: center;
    }
  }


  /* ========================================
     MOBILE SLIDE SIZE — 1080 x 1350
     ======================================== */

  @media screen and (max-width: 749px) {

    #shopify-section-{{ section.id }} #Slider-{{ section.id }} {
      width: 100%;
      height: auto !important;
      min-height: 0 !important;
      aspect-ratio: 4 / 5;
    }

    #shopify-section-{{ section.id }} .gryphon-slide {
      height: 100% !important;
      min-height: 0 !important;
      position: relative !important;
    }


    /* BRANDING MOBILE — FULL IMAGE */

    #shopify-section-{{ section.id }} .gryphon-slide--branding .slideshow__media {
      position: absolute !important;
      inset: 0 !important;
      width: 100% !important;
      height: 100% !important;
    }

#shopify-section-{{ section.id }} .gryphon-slide--branding .slideshow__media img,
#shopify-section-{{ section.id }} .gryphon-slide--branding .slideshow__media video {
  width: 100% !important;
  height: 100% !important;
  object-fit: contain !important;
  display: block;
}

    #shopify-section-{{ section.id }} .gryphon-slide--branding .slideshow__text-wrapper {
      display: none !important;
    }


    /* PROMO MOBILE — IMAGE TOP 50% */

    #shopify-section-{{ section.id }} .gryphon-slide--promo .slideshow__media {
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      bottom: auto !important;
      width: 100% !important;
      height: 50% !important;
      min-height: 0 !important;
    }

    #shopify-section-{{ section.id }} .gryphon-slide--promo .slideshow__media img {
      width: 100% !important;
      height: 100% !important;
      object-fit: contain !important;
    }


    /* PROMO MOBILE — TEXT BOTTOM 50% */

    #shopify-section-{{ section.id }} .gryphon-slide--promo .slideshow__text-wrapper {
      position: absolute !important;
      top: 50% !important;
      left: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      width: 100% !important;
      height: 50% !important;
      min-height: 0 !important;
      margin: 0 !important;
      padding: 0 !important;
      background: var(--gryphon-promo-background) !important;
    }

    #shopify-section-{{ section.id }} .gryphon-slide--promo .slideshow__text {
      width: 100% !important;
      max-width: none !important;
      height: 100% !important;
      min-height: 0 !important;
      margin: 0 !important;
      padding:
  var(--gryphon-mobile-padding-top)
  24px
  var(--gryphon-mobile-padding-bottom)
  !important;
      border-radius: 0 !important;
      background: var(--gryphon-promo-background) !important;
      display: flex !important;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .gryphon-slide--promo .banner__heading {
      margin: 0 !important;
    }

    #shopify-section-{{ section.id }} .gryphon-slide--promo .banner__text {
      margin-top: 10px !important;
    }

  #shopify-section-{{ section.id }} .gryphon-slide--promo .banner__buttons {
  margin-top: var(--gryphon-button-margin-top) !important;
}
  }


  /* ========================================
     PROMO BUTTON
     ======================================== */

#shopify-section-{{ section.id }} .gryphon-slide--promo .button {
  background: var(--gryphon-button-color) !important;
  color: var(--gryphon-button-text-color) !important;
  border: none !important;
  min-width: 180px;
  min-height: 46px;
  border-radius: 999px;
  opacity: 1;
  transition:
    background 0.25s ease,
    color 0.25s ease;
}

#shopify-section-{{ section.id }} .gryphon-slide--promo .button::before,
#shopify-section-{{ section.id }} .gryphon-slide--promo .button::after {
  box-shadow: none !important;
  border: none !important;
}

#shopify-section-{{ section.id }} .gryphon-slide--promo .button:hover {
  background: var(--gryphon-button-hover-color) !important;
  color: var(--gryphon-button-hover-text-color) !important;
  opacity: 1;
}
/* ========================================
   AESOP-STYLE PAGINATION
   ======================================== */

#shopify-section-{{ section.id }} slideshow-component {
  position: relative;
}

/* Overlay controls on banner */
#shopify-section-{{ section.id }} .slideshow__controls {
  position: absolute !important;
  inset: 0 !important;
  width: 100% !important;
  height: 100% !important;
  z-index: 5;
  border: 0 !important;
  background: transparent !important;
  pointer-events: none;
}

/* Hide arrows */
#shopify-section-{{ section.id }} .slider-button--prev,
#shopify-section-{{ section.id }} .slider-button--next {
  display: none !important;
}

/* Hide pause/play */
#shopify-section-{{ section.id }} .slideshow__autoplay {
  display: none !important;
}

/* Pagination position */
#shopify-section-{{ section.id }} .slider-counter {
  position: absolute !important;
  left: 50%;
  bottom: 18px;
  transform: translateX(-50%);
  min-width: 0;
  margin: 0 !important;
  pointer-events: auto;
}

#shopify-section-{{ section.id }} .slideshow__control-wrapper {
  display: flex;
  align-items: center;
  gap: 8px;
}

/* Remove Dawn dot spacing */
#shopify-section-{{ section.id }} .slider-counter__link--dots {
  padding: 8px 0 !important;
}

/* Inactive line */
#shopify-section-{{ section.id }} .slider-counter__link--dots .dot {
  width: 46px !important;
  height: 3px !important;
  border: 0 !important;
  border-radius: 0 !important;
  background: #F4F4F7 !important;
  opacity: 0.55;
  transform: none !important;
}

/* Active line */
#shopify-section-{{ section.id }}
  .slider-counter__link--active.slider-counter__link--dots
  .dot {
  background: #F4F4F7 !important;
  opacity: 1;
  transform: none !important;
}

/* Stop hover scaling */
#shopify-section-{{ section.id }}
  .slider-counter__link--dots:hover
  .dot {
  transform: none !important;
}

/* MOBILE */
@media screen and (max-width: 749px) {
  #shopify-section-{{ section.id }} .slider-counter {
    bottom: 12px;
  }

  #shopify-section-{{ section.id }} .slideshow__control-wrapper {
    gap: 6px;
  }

  #shopify-section-{{ section.id }} .slider-counter__link--dots .dot {
    width: 30px !important;
    height: 2px !important;
  }
}
/* ========================================
   FIXED PROMO TEXT SPACING
   ======================================== */

#shopify-section-{{ section.id }} .gryphon-slide--promo .slideshow__text {
  gap: 0 !important;
}

/* Heading */
#shopify-section-{{ section.id }} .gryphon-slide--promo .banner__heading {
  margin: 0 !important;
}

/* Fixed gap: heading → subheading */
#shopify-section-{{ section.id }} .gryphon-slide--promo .banner__text {
  margin: 12px 0 0 !important;
}

/* Fixed gap: subheading → button */
#shopify-section-{{ section.id }} .gryphon-slide--promo .banner__buttons {
  margin: 16px 0 0 !important;
  padding: 0 !important;
}
/* ========================================
   MOBILE ONLY — FIX PROMO TEXT/BUTTON GAP
   ======================================== */

@media screen and (max-width: 749px) {

#shopify-section-{{ section.id }} .gryphon-slide--promo .slideshow__text {
  display: grid !important;
  grid-template-columns: 1fr !important;
  grid-auto-rows: max-content !important;
  align-content: start !important;
  justify-items: center !important;
  gap: 0 !important;

  padding-top: var(--gryphon-mobile-padding-top) !important;
  padding-right: 24px !important;
  padding-bottom: var(--gryphon-mobile-padding-bottom) !important;
  padding-left: 24px !important;
}

  /* Kill Dawn's automatic margins */
  #shopify-section-{{ section.id }} .gryphon-slide--promo .slideshow__text > * {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }

  #shopify-section-{{ section.id }} .gryphon-slide--promo .banner__text p {
    margin: 0 !important;
  }

  /* Heading → subheading */
  #shopify-section-{{ section.id }}
  .gryphon-slide--promo
  .banner__heading + .banner__text {
    margin-top: 12px !important;
  }

  /* Subheading → button: FIXED 16px */
  #shopify-section-{{ section.id }}
  .gryphon-slide--promo
  .banner__text + .banner__buttons {
    margin-top: 16px !important;
  }

  /* If there is no subheading */
  #shopify-section-{{ section.id }}
  .gryphon-slide--promo
  .banner__heading + .banner__buttons {
    margin-top: 16px !important;
  }

  #shopify-section-{{ section.id }} .gryphon-slide--promo .banner__buttons {
    position: static !important;
    transform: none !important;
    align-self: center !important;
    padding: 0 !important;
  }
}
/* ========================================
   PROMO TEXT COLOUR
   ======================================== */

#shopify-section-{{ section.id }} .gryphon-slide--promo .banner__heading,
#shopify-section-{{ section.id }} .gryphon-slide--promo .banner__text,
#shopify-section-{{ section.id }} .gryphon-slide--promo .banner__text p {
  color: var(--gryphon-promo-text) !important;
}
/* ========================================
   BRANDING VIDEO
   ======================================== */

#shopify-section-{{ section.id }} .gryphon-slide--branding video {
  pointer-events: none !important;
}

/* Hide browser video controls */
#shopify-section-{{ section.id }} .gryphon-slide--branding video::-webkit-media-controls {
  display: none !important;
}
</style>

<slideshow-component
  class="slider-mobile-gutter{% if section.settings.layout == 'grid' %} page-width{% endif %}{% if section.settings.show_text_below %} mobile-text-below{% endif %}"
  role="region"
  aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
  aria-label="{{ section.settings.accessibility_info | escape }}"
>
  {%- if section.settings.auto_rotate and section.blocks.size > 1 -%}
    <div class="slideshow__controls slideshow__controls--top slider-buttons{% if section.settings.show_text_below %} slideshow__controls--border-radius-mobile{% endif %}">
      <button
        type="button"
        class="slider-button slider-button--prev"
        name="previous"
        aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>
      <div class="slider-counter slider-counter--{{ section.settings.slider_visual }}{% if section.settings.slider_visual == 'counter' or section.settings.slider_visual == 'numbers' %} caption{% endif %}">
        {%- if section.settings.slider_visual == 'counter' -%}
          <span class="slider-counter--current">1</span>
          <span aria-hidden="true"> / </span>
          <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
          <span class="slider-counter--total">{{ section.blocks.size }}</span>
        {%- else -%}
          <div class="slideshow__control-wrapper">
            {%- for block in section.blocks -%}
              <button
                class="slider-counter__link slider-counter__link--{{ section.settings.slider_visual }} link"
                aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                aria-controls="Slider-{{ section.id }}"
              >
                {%- if section.settings.slider_visual == 'numbers' -%}
                  {{ forloop.index -}}
                {%- else -%}
                  <span class="dot"></span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <button
        type="button"
        class="slider-button slider-button--next"
        name="next"
        aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
        aria-controls="Slider-{{ section.id }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>

      {%- if section.settings.auto_rotate -%}
        <button
          type="button"
          class="slideshow__autoplay slider-button{% if section.settings.auto_rotate == false %} slideshow__autoplay--paused{% endif %}"
          aria-label="{{ 'sections.slideshow.pause_slideshow' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-pause.svg' | inline_asset_content -}}
          </span>
          <span class="svg-wrapper">
            {{- 'icon-play.svg' | inline_asset_content -}}
          </span>
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div
    class="slideshow banner banner--{{ section.settings.slide_height }} grid grid--1-col slider slider--everywhere{% if section.settings.show_text_below %} banner--mobile-bottom{% endif %}{% if section.blocks.first.settings.image == blank %} slideshow--placeholder{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
    id="Slider-{{ section.id }}"
    aria-live="polite"
    aria-atomic="true"
    data-autoplay="false"
    data-speed="{{ section.settings.change_slides_speed }}"
  >
    {%- for block in section.blocks -%}
      <style>
        #Slide-{{ section.id }}-{{ forloop.index }} .banner__media::after {
          opacity: {{ block.settings.image_overlay_opacity | divided_by: 100.0 }};
        }
      </style>
      <div
        class="slideshow__slide gryphon-slide gryphon-slide--{{ block.settings.gryphon_layout }} grid__item grid--1-col slider__slide"
        data-gryphon-media-type="{{ block.settings.branding_media_type }}"
style="
  --gryphon-promo-background: {{ block.settings.promo_background }};
  --gryphon-promo-text: {{ block.settings.promo_text_color }};
  --gryphon-button-color: {{ block.settings.promo_button_color }};
  --gryphon-button-text-color: {{ block.settings.promo_button_text_color }};
  --gryphon-button-hover-color: {{ block.settings.promo_button_hover_color }};
  --gryphon-button-hover-text-color: {{ block.settings.promo_button_hover_text_color }};
  --gryphon-desktop-padding: {{ block.settings.desktop_content_padding }}px;
  --gryphon-mobile-padding-top: {{ block.settings.mobile_padding_top }}px;
  --gryphon-mobile-padding-bottom: {{ block.settings.mobile_padding_bottom }}px;
"
        id="Slide-{{ section.id }}-{{ forloop.index }}"
        {{ block.shopify_attributes }}
        role="group"
        aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
        aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
        tabindex="-1"
      >
<div
  class="slideshow__media banner__media media
    {% if block.settings.image == blank and block.settings.branding_video == blank %} placeholder{% endif %}
    {% if block.settings.mobile_image != blank %} has-mobile-image{% endif %}
    {% if block.settings.branding_mobile_video != blank %} has-mobile-video{% endif %}
    {% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}
  "
>

  {%- if block.settings.gryphon_layout == 'branding' and block.settings.branding_media_type == 'video' -%}

    {%- comment -%}
      BRANDING VIDEO
    {%- endcomment -%}

    {%- if block.settings.branding_video != blank -%}
      {{
        block.settings.branding_video
       | video_tag:
  muted: true,
  controls: false,
  playsinline: true,
  class: 'gryphon-desktop-video'
      }}
    {%- endif -%}

    {%- if block.settings.branding_mobile_video != blank -%}
      {{
        block.settings.branding_mobile_video
        | video_tag:
  muted: true,
  controls: false,
  playsinline: true,
  class: 'gryphon-mobile-video'
      }}
    {%- endif -%}


  {%- else -%}

    {%- comment -%}
      IMAGE — USED FOR BRANDING IMAGE MODE + PROMO SLIDES
    {%- endcomment -%}

    {%- if block.settings.image != blank -%}

      {%- liquid
        assign height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round

        if section.settings.image_behavior == 'ambient'
          assign sizes = '120vw'
          assign widths = '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680'
        else
          assign sizes = '100vw'
          assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
        endif

        assign fetch_priority = 'auto'

        if section.index == 1
          assign fetch_priority = 'high'
        endif
      -%}

      {%- if forloop.first -%}

        {{
          block.settings.image
          | image_url: width: 3840
          | image_tag:
            class: 'gryphon-desktop-image',
            height: height,
            sizes: sizes,
            widths: widths,
            fetchpriority: fetch_priority
        }}

      {%- else -%}

        {{
          block.settings.image
          | image_url: width: 3840
          | image_tag:
            class: 'gryphon-desktop-image',
            loading: 'lazy',
            height: height,
            sizes: sizes,
            widths: widths
        }}

      {%- endif -%}


      {%- if block.settings.mobile_image != blank -%}

        {%- assign mobile_height = block.settings.mobile_image.width
          | divided_by: block.settings.mobile_image.aspect_ratio
          | round
        -%}

        {{
          block.settings.mobile_image
          | image_url: width: 1500
          | image_tag:
            class: 'gryphon-mobile-image',
            loading: 'lazy',
            height: mobile_height,
            sizes: '100vw',
            widths: '375, 550, 750, 1100, 1500'
        }}

      {%- endif -%}


    {%- else -%}

      {%- assign placeholder_slide = forloop.index | modulo: 2 -%}

      {%- if placeholder_slide == 1 -%}
        {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}

    {%- endif -%}

  {%- endif -%}

</div>

<div class="slideshow__text-wrapper banner__content banner__content--{{ block.settings.box_align }} page-width{% if block.settings.show_text_box == false %} banner--desktop-transparent{% endif %}{% if settings.animations_reveal_on_scroll and forloop.index == 1 %} scroll-trigger animate--slide-in{% endif %}">
  <div class="slideshow__text banner__box content-container content-container--full-width-mobile color-{{ block.settings.color_scheme }} gradient slideshow__text--{{ block.settings.text_alignment }} slideshow__text-mobile--{{ block.settings.text_alignment_mobile }}">

    {%- if block.settings.heading != blank -%}
      <h2 class="banner__heading inline-richtext {{ block.settings.heading_size }}">
        {{ block.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if block.settings.subheading != blank -%}
      <div class="banner__text rte">
        <p>{{ block.settings.subheading }}</p>
      </div>
    {%- endif -%}

    {%- if block.settings.button_label != blank -%}
      <div class="banner__buttons">
        <a
          {% if block.settings.link %}
            href="{{ block.settings.link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
          class="button {% if block.settings.button_style_secondary %}button--secondary{% else %}button--primary{% endif %}"
        >
          {{- block.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

</div>
{%- endfor -%}

</div>

{%- if section.blocks.size > 1 and section.settings.auto_rotate == false -%}
  <div class="slideshow__controls slider-buttons{% if section.settings.show_text_below %} slideshow__controls--border-radius-mobile{% endif %}">

    <button
      type="button"
      class="slider-button slider-button--prev"
      name="previous"
      aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
      aria-controls="Slider-{{ section.id }}"
    >
      <span class="svg-wrapper">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
    </button>

    <div class="slider-counter slider-counter--{{ section.settings.slider_visual }}{% if section.settings.slider_visual == 'counter' or section.settings.slider_visual == 'numbers' %} caption{% endif %}">

      {%- if section.settings.slider_visual == 'counter' -%}

        <span class="slider-counter--current">1</span>
        <span aria-hidden="true"> / </span>
        <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
        <span class="slider-counter--total">{{ section.blocks.size }}</span>

      {%- else -%}

        <div class="slideshow__control-wrapper">

          {%- for block in section.blocks -%}
            <button
              class="slider-counter__link slider-counter__link--{{ section.settings.slider_visual }} link"
              aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
              aria-controls="Slider-{{ section.id }}"
            >
              {%- if section.settings.slider_visual == 'numbers' -%}
                {{ forloop.index }}
              {%- else -%}
                <span class="dot"></span>
              {%- endif -%}
            </button>
          {%- endfor -%}

        </div>

      {%- endif -%}

    </div>

    <button
      type="button"
      class="slider-button slider-button--next"
      name="next"
      aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
      aria-controls="Slider-{{ section.id }}"
    >
      <span class="svg-wrapper">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
    </button>

  </div>
{%- endif -%}

</slideshow-component>
<script>
(function () {

  function initGryphonSlideshow() {

    const section = document.querySelector('#shopify-section-{{ section.id }}');

    if (!section) return;

    /* Prevent double initialization */
    if (section.dataset.gryphonVideoSliderReady === 'true') return;

    const component = section.querySelector('slideshow-component');
    const slider = section.querySelector('#Slider-{{ section.id }}');

    if (!component || !slider) return;

    section.dataset.gryphonVideoSliderReady = 'true';

    const slides = Array.from(
      slider.querySelectorAll('.gryphon-slide')
    );

    const imageDelay =
      {{ section.settings.change_slides_speed | times: 1000 }};

    let imageTimer = null;
    let scrollTimer = null;
    let currentVideo = null;


    /* ========================================
       FIND CURRENT SLIDE
       ======================================== */

    function getCurrentIndex() {

      const slideWidth = slider.clientWidth;

      if (!slideWidth) return 0;

      return Math.round(
        slider.scrollLeft / slideWidth
      );
    }


    /* ========================================
       FIND VISIBLE DESKTOP / MOBILE VIDEO
       ======================================== */

    function getVisibleVideo(slide) {

      const videos = Array.from(
        slide.querySelectorAll('video')
      );

      return videos.find(function (video) {

        const style = window.getComputedStyle(video);

        return (
          style.display !== 'none' &&
          style.visibility !== 'hidden' &&
          video.offsetWidth > 0 &&
          video.offsetHeight > 0
        );

      });

    }


    /* ========================================
       CLEAR CURRENT TIMER / VIDEO EVENT
       ======================================== */

    function clearCurrentState() {

      if (imageTimer) {
        clearTimeout(imageTimer);
        imageTimer = null;
      }

      if (currentVideo) {
        currentVideo.onended = null;
        currentVideo = null;
      }

    }


    /* ========================================
       NEXT SLIDE
       ======================================== */

    function goToNextSlide() {

      clearCurrentState();

      const nextButton =
        component.querySelector('.slider-button--next');

      if (!nextButton) return;

      nextButton.click();

      /*
        Give Dawn time to move to the next slide,
        then start that slide's timing.
      */
      setTimeout(function () {
        runCurrentSlide();
      }, 350);

    }


    /* ========================================
       RUN ACTIVE SLIDE
       ======================================== */

    function runCurrentSlide() {

      clearCurrentState();

      let currentIndex = getCurrentIndex();

      if (currentIndex < 0) currentIndex = 0;

      if (currentIndex >= slides.length) {
        currentIndex = slides.length - 1;
      }

      const currentSlide = slides[currentIndex];

      if (!currentSlide) return;


      /* Pause/reset videos on OTHER slides */

      slides.forEach(function (slide, index) {

        slide.querySelectorAll('video').forEach(function (video) {

          if (index !== currentIndex) {

            video.pause();

            try {
              video.currentTime = 0;
            } catch (e) {}

          }

        });

      });


      const video = getVisibleVideo(currentSlide);


      /* ====================================
         VIDEO SLIDE
         ==================================== */

      if (video) {

        currentVideo = video;

        video.pause();

        try {
          video.currentTime = 0;
        } catch (e) {}

        video.loop = false;
        video.muted = true;


        /* THIS moves slideshow when video ends */

        video.onended = function () {
          goToNextSlide();
        };


        const playPromise = video.play();

        if (playPromise !== undefined) {

          playPromise.catch(function (error) {
            console.log('Gryphon video autoplay blocked:', error);
          });

        }

        return;
      }


      /* ====================================
         IMAGE / PROMO SLIDE
         ==================================== */

      imageTimer = setTimeout(function () {

        goToNextSlide();

      }, imageDelay);

    }


    /* ========================================
       MANUAL SWIPE / PAGINATION
       ======================================== */

    slider.addEventListener('scroll', function () {

      clearTimeout(scrollTimer);

      scrollTimer = setTimeout(function () {
        runCurrentSlide();
      }, 300);

    });


    /* ========================================
       DESKTOP ↔ MOBILE
       ======================================== */

    window.addEventListener('resize', function () {

      clearTimeout(scrollTimer);

      scrollTimer = setTimeout(function () {
        runCurrentSlide();
      }, 300);

    });


    /* START IMMEDIATELY */
    runCurrentSlide();

  }


  /* Normal storefront */
  if (document.readyState === 'loading') {

    document.addEventListener(
      'DOMContentLoaded',
      initGryphonSlideshow
    );

  } else {

    initGryphonSlideshow();

  }


  /* Shopify Customize section reload */
  document.addEventListener(
    'shopify:section:load',
    function (event) {

      if (
        event.target &&
        event.target.id === 'shopify-section-{{ section.id }}'
      ) {
        initGryphonSlideshow();
      }

    }
  );

})();
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {

  const section = document.querySelector('#shopify-section-{{ section.id }}');
  if (!section) return;

  const component = section.querySelector('slideshow-component');
  const slider = section.querySelector('#Slider-{{ section.id }}');

  if (!component || !slider) return;

  const slides = Array.from(
    slider.querySelectorAll('.gryphon-slide')
  );

  const imageDelay = {{ section.settings.change_slides_speed | times: 1000 }};

  let timer = null;
  let activeVideo = null;
  let scrollTimer = null;


  /* ----------------------------------------
     FIND CURRENT SLIDE
     ---------------------------------------- */

  function getCurrentIndex() {

    const dots = Array.from(
      component.querySelectorAll('.slider-counter__link')
    );

    const activeDot = component.querySelector(
      '.slider-counter__link--active'
    );

    if (activeDot && dots.length) {
      const index = dots.indexOf(activeDot);

      if (index >= 0) {
        return index;
      }
    }

    const slideWidth = slider.clientWidth || 1;

    return Math.round(
      slider.scrollLeft / slideWidth
    );
  }


  /* ----------------------------------------
     FIND THE VIDEO ACTUALLY VISIBLE
     Desktop OR Mobile
     ---------------------------------------- */

  function getVisibleVideo(slide) {

    const videos = Array.from(
      slide.querySelectorAll('video')
    );

    return videos.find(function (video) {

      const style = window.getComputedStyle(video);

      return (
        style.display !== 'none' &&
        style.visibility !== 'hidden'
      );

    });
  }


  /* ----------------------------------------
     STOP OLD TIMERS / VIDEOS
     ---------------------------------------- */

  function clearCurrentPlayback() {

    if (timer) {
      clearTimeout(timer);
      timer = null;
    }

    if (activeVideo) {
      activeVideo.onended = null;
      activeVideo = null;
    }

  }


  /* ----------------------------------------
     GO TO NEXT SLIDE
     ---------------------------------------- */

  function goToNextSlide() {

    clearCurrentPlayback();

    const dots = Array.from(
      component.querySelectorAll('.slider-counter__link')
    );

    const currentIndex = getCurrentIndex();

    const nextIndex =
      (currentIndex + 1) % slides.length;


    /* Use Dawn pagination so its own
       slider logic remains intact */

    if (dots[nextIndex]) {

      dots[nextIndex].click();

    } else {

      const nextButton =
        component.querySelector('.slider-button--next');

      if (nextButton) {
        nextButton.click();
      }

    }
  }


  /* ----------------------------------------
     CONTROL CURRENT SLIDE
     ---------------------------------------- */

  function runCurrentSlide() {

    clearCurrentPlayback();

    const currentIndex = getCurrentIndex();

    const currentSlide = slides[currentIndex];

    if (!currentSlide) return;


    /* Pause + reset every video
       that is not on current slide */

    slides.forEach(function (slide, index) {

      slide.querySelectorAll('video').forEach(function (video) {

        if (index !== currentIndex) {

          video.pause();

          try {
            video.currentTime = 0;
          } catch (e) {}

        }

      });

    });


const isVideoSlide =
  currentSlide.classList.contains('gryphon-slide--branding') &&
  currentSlide.dataset.gryphonMediaType === 'video';

const video = getVisibleVideo(currentSlide);

if (isVideoSlide && video) {

      activeVideo = video;

      video.pause();

      try {
        video.currentTime = 0;
      } catch (e) {}

      video.loop = false;
      video.muted = true;

      video.onended = function () {
        goToNextSlide();
      };

      const playPromise = video.play();

      if (playPromise !== undefined) {
        playPromise.catch(function () {
          /* Muted autoplay normally works.
             Do nothing if browser blocks it. */
        });
      }

      return;
    }


    /* ------------------------------------
       IMAGE / PROMO SLIDE
       ------------------------------------ */

    timer = setTimeout(function () {

      goToNextSlide();

    }, imageDelay);

  }


  /* ----------------------------------------
     USER SWIPE / DOT CHANGE
     ---------------------------------------- */

  slider.addEventListener('scroll', function () {

    clearTimeout(scrollTimer);

    scrollTimer = setTimeout(function () {

      runCurrentSlide();

    }, 250);

  });


  /* ----------------------------------------
     IF SCREEN CHANGES MOBILE ↔ DESKTOP
     choose correct video again
     ---------------------------------------- */

  window.addEventListener('resize', function () {

    clearTimeout(scrollTimer);

    scrollTimer = setTimeout(function () {

      runCurrentSlide();

    }, 250);

  });
/* ========================================
   CLICK BANNER → NEXT SLIDE
   ======================================== */

slider.addEventListener('click', function (event) {

  /* Don't change slide when clicking links/buttons */
  if (
    event.target.closest(
      'a, button, input, select, textarea, label'
    )
  ) {
    return;
  }

  goToNextSlide();

});

  /* ----------------------------------------
     START
     ---------------------------------------- */

  runCurrentSlide();

});
</script>
