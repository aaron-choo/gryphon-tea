{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
<style>
.gryphon-new-footer{background:#fff;color:#5e6b47;font-family:var(--font-body-family);font-size:13px;line-height:1.5}
.gryphon-new-footer *{box-sizing:border-box}
.gryphon-new-footer a{color:inherit;text-decoration:none}
.gryphon-new-footer a:hover{text-decoration:underline;text-underline-offset:3px}
.gryphon-new-footer .gf-inner{max-width:1440px;margin:auto;padding:44px 48px 30px}
.gryphon-new-footer .gf-grid{display:grid;grid-template-columns:minmax(190px,1.35fr) repeat(3,minmax(125px,1fr));gap:28px}
.gryphon-new-footer .gf-brand{font-size:18px;letter-spacing:.055em;font-weight:500}
.gryphon-new-footer .gf-tagline{font-size:11px;letter-spacing:.12em;margin:12px 0 0}
.gryphon-new-footer .gf-title{font-size:13px;font-weight:600;letter-spacing:.02em;margin:0 0 12px}
.gryphon-new-footer .gf-links{list-style:none;margin:0;padding:0;display:grid;gap:7px}
.gryphon-new-footer details{border:0}
.gryphon-new-footer summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:12px}
.gryphon-new-footer summary::-webkit-details-marker{display:none}
.gryphon-new-footer summary:after{content:'+';font-size:18px;font-weight:400;line-height:1}
.gryphon-new-footer details[open] summary:after{content:'−'}
.gryphon-new-footer details .gf-links{padding-top:12px}
.gryphon-new-footer .gf-rule{border-top:1px solid #c9d3c2;margin-top:32px}
.gryphon-new-footer .gf-copyright{text-align:center;font-size:11px;line-height:1.55;padding-top:19px}
.gryphon-new-footer .gf-copyright p{margin:0 0 6px}
.gryphon-new-footer .gf-newsletter{border-bottom:1px solid #c9d3c2}
.gryphon-new-footer .gf-newsletter-inner{max-width:1440px;margin:auto;padding:28px 48px;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:32px}
.gryphon-new-footer .gf-newsletter-title{font-size:19px;line-height:1.25;font-weight:400;margin:0}
.gryphon-new-footer .gf-newsletter .newsletter-form{max-width:440px;width:100%}
.gryphon-new-footer .gf-newsletter .newsletter-form__field-wrapper{max-width:100%}
.gryphon-new-footer .gf-newsletter .field{border-bottom:1px solid #5e6b47}
.gryphon-new-footer .gf-newsletter .field:before,.gryphon-new-footer .gf-newsletter .field:after{display:none}
.gryphon-new-footer .gf-newsletter .field__input{background:transparent;color:#5e6b47;box-shadow:none;border:0;font-size:13px}
.gryphon-new-footer .gf-newsletter .field__label{color:#5e6b47;font-size:13px}
.gryphon-new-footer .gf-newsletter .newsletter-form__button{color:#5e6b47}
.gryphon-new-footer .gf-newsletter-note{font-size:12px;margin:8px 0 0}
@media(max-width:749px){
.gryphon-new-footer .gf-inner{padding:28px 22px 24px}
.gryphon-new-footer .gf-grid{grid-template-columns:1fr;gap:0}
.gryphon-new-footer .gf-brand-block{padding-bottom:20px}
.gryphon-new-footer .gf-brand{font-size:16px}
.gryphon-new-footer .gf-tagline{font-size:10px;margin-top:8px}
.gryphon-new-footer .gf-mobile-details{border-top:1px solid #c9d3c2}
.gryphon-new-footer .gf-mobile-details:last-child{border-bottom:1px solid #c9d3c2}
.gryphon-new-footer .gf-mobile-details summary{padding:13px 0;font-size:13px;font-weight:600}
.gryphon-new-footer .gf-mobile-details .gf-links{padding:0 0 15px;gap:8px}
.gryphon-new-footer .gf-rule{margin-top:20px}
.gryphon-new-footer .gf-copyright{font-size:10px;padding-top:16px}
.gryphon-new-footer .gf-newsletter-inner{padding:24px 22px;grid-template-columns:1fr;gap:12px}
.gryphon-new-footer .gf-newsletter-title{font-size:17px}
}
@media(min-width:750px){.gryphon-new-footer .gf-mobile-details.gf-mobile-only{display:none}}
@media(max-width:749px){.gryphon-new-footer .gf-desktop-group{display:none}}
</style>
<div class="gryphon-new-footer">
{% if section.settings.newsletter_enable %}
<div class="gf-newsletter"><div class="gf-newsletter-inner">
<div><h2 class="gf-newsletter-title">{{ section.settings.newsletter_heading | default: 'Crafted for Connection' }}</h2>{% if section.settings.newsletter_legal != blank %}<div class="gf-newsletter-note">{{ section.settings.newsletter_legal }}</div>{% endif %}</div>
{% form 'customer', id: 'ContactFooter', class: 'newsletter-form' %}
<input type="hidden" name="contact[tags]" value="newsletter">
<div class="newsletter-form__field-wrapper"><div class="field">
<input id="NewsletterForm--{{ section.id }}" type="email" name="contact[email]" class="field__input" value="{{ form.email }}" autocomplete="email" autocapitalize="off" aria-required="true" required placeholder="Enter your email address" {% if form.errors %}aria-invalid="true" aria-describedby="ContactFooter-error"{% endif %}>
<label class="field__label" for="NewsletterForm--{{ section.id }}">Enter your email address</label>
<button type="submit" class="newsletter-form__button field__button" name="commit" aria-label="Subscribe">{{ 'icon-arrow.svg' | inline_asset_content }}</button>
</div>{% if form.errors %}<small id="ContactFooter-error">{{ form.errors.messages.email }}</small>{% endif %}</div>
{% if form.posted_successfully? %}<p id="ContactFooter-success" role="status">{{ 'newsletter.success' | t }}</p>{% endif %}
{% endform %}
</div></div>
{% endif %}
<div class="gf-inner"><div class="gf-grid">
<div class="gf-brand-block"><div class="gf-brand">GRYPHON® SINGAPORE</div><p class="gf-tagline">THE ART AND SCIENCE OF TEA</p></div>
{% assign gf_brands = blank %}{% assign gf_about = blank %}{% assign gf_faq = blank %}
{% for block in section.blocks %}{% if block.type == 'link_list' %}
{% assign gf_heading = block.settings.heading | downcase %}
{% if gf_heading contains 'brand' %}{% assign gf_brands = block.settings.menu %}{% elsif gf_heading contains 'about' %}{% assign gf_about = block.settings.menu %}{% elsif gf_heading contains 'support' or gf_heading contains 'faq' %}{% assign gf_faq = block.settings.menu %}{% endif %}
{% endif %}{% endfor %}
{% assign gf_brands = gf_brands | default: linklists['our-brands'] %}
{% assign gf_about = gf_about | default: linklists['about-us'] %}
{% assign gf_faq = gf_faq | default: linklists['faq'] %}
<div class="gf-desktop-group"><h3 class="gf-title">Our Brands</h3><ul class="gf-links">{% for link in gf_brands.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul></div>
<div class="gf-desktop-group"><h3 class="gf-title">About Us</h3><ul class="gf-links">{% for link in gf_about.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul></div>
<details class="gf-desktop-group"><summary class="gf-title">FAQ</summary><ul class="gf-links">{% for link in gf_faq.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul></details>
<details class="gf-mobile-details gf-mobile-only"><summary>Our Brands</summary><ul class="gf-links">{% for link in gf_brands.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul></details>
<details class="gf-mobile-details gf-mobile-only"><summary>About Us</summary><ul class="gf-links">{% for link in gf_about.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul></details>
<details class="gf-mobile-details gf-mobile-only"><summary>FAQ</summary><ul class="gf-links">{% for link in gf_faq.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul></details>
</div><div class="gf-rule"></div><div class="gf-copyright"><div>{{ section.settings.copyright_text }}</div><div>{{ section.settings.copyright_disclaimer }}</div></div></div></div>
{% schema %}



